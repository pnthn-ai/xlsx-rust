  {
    "id": "fn.map.iife-lambda-not-parsed",
    "description": "Immediately-invoked LAMBDA(...)(args) is not parsed",
    "tags": ["map", "lambda"],
    "formula": "=MAP({1},LAMBDA(x,x)(1))",
    "expected": { "array": [[{ "number": 1 }]] },
    "ignore": "Immediately-invoked LAMBDA(...)(args) is not in the parser. MAP requires an inline LAMBDA(p, body) or a defined name that refers to one."
