  {
    "id": "fn.map.scalar-no-broadcast",
    "description": "A 1×1 sibling does not broadcast across a vector",
    "tags": ["map", "lambda", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=MAP({1,2,3},10,LAMBDA(a,b,a+b))",
    "expected": {
      "array": [[{ "number": 11 }, { "error": "#N/A" }, { "error": "#N/A" }]]
    },
    "notes": "Unlike FILTER include or A1:A3+10, MAP does not lift a scalar across the other array. Use EXPAND to repeat the scalar."
  },
