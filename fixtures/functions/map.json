  {
    "id": "fn.map.times2-row",
    "description": "MAP a 1×3 literal, doubling each element",
    "tags": ["map", "lambda", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=MAP({1,2,3},LAMBDA(x,x*2))",
    "expected": { "array": [[{ "number": 2 }, { "number": 4 }, { "number": 6 }]] }
  },
