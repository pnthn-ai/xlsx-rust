  {
    "id": "fn.xirr-ms-example",
    "description": "Microsoft example: XIRR(A2:A6, B2:B6) on the 2008–2009 schedule is ~37.34%",
    "tags": ["xirr", "financial"],
    "formula": "=XIRR(A2:A6,B2:B6)",
    "expected": { "number": 0.3733625335188315 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A2": { "number": -10000 },
          "A3": { "number": 2750 },
          "A4": { "number": 4250 },
          "A5": { "number": 3250 },
          "A6": { "number": 2750 },
          "B2": { "formula": "=DATE(2008,1,1)" },
          "B3": { "formula": "=DATE(2008,3,1)" },
          "B4": { "formula": "=DATE(2008,10,30)" },
          "B5": { "formula": "=DATE(2009,2,15)" },
          "B6": { "formula": "=DATE(2009,4,1)" }
        }
      }]
    }
  },
