[
  {
    "id": "fn.rri.ms-96mo",
    "description": "Microsoft RRI example: $10,000 → $11,000 over 96 months",
    "tags": ["rri", "financial"],
    "notes": "support.microsoft.com RRI publishes 0.0009933. Golden is the OpenFormula 6.12.45 identity expm1(ln1p((fv-pv)/pv)/nper).",
    "formula": "=RRI(96, 10000, 11000)",
    "expected": { "number": 0.0009933073762913949 }
  },
  {
    "id": "fn.rri.ms-cells",
    "description": "Same Microsoft example via cell refs (A1=96, A2=10000, A3=11000)",
    "tags": ["rri", "financial"],
    "formula": "=RRI(A1, A2, A3)",
    "expected": { "number": 0.0009933073762913949 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 96 },
          "A2": { "number": 10000 },
          "A3": { "number": 11000 }
        }
      }]
    }
  },
  {
    "id": "fn.rri.named",
    "description": "RRI of defined names for nper / pv / fv",
    "tags": ["rri", "financial", "named"],
    "formula": "=RRI(Nper, Pv, Fv)",
    "expected": { "number": 0.0009933073762913949 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 96 },
          "A2": { "number": 10000 },
          "A3": { "number": 11000 }
        }
      }],
      "names": [
        { "name": "Nper", "refers_to": "Sheet1!A1" },
        { "name": "Pv", "refers_to": "Sheet1!A2" },
        { "name": "Fv", "refers_to": "Sheet1!A3" }
      ]
    }
  },
