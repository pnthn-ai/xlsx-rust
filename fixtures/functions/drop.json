  {
    "id": "fn.drop.zero-rows",
    "description": "rows=0 is a no-op (omitted cols defaults to 0)",
    "notes": "Microsoft's DROP page says #CALC! 'when rows or columns is 0'. That contradicts their own examples and the useful DROP(data,0) no-op. 0 is a no-op on that axis; #CALC! is an empty result.",
    "tags": ["drop", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=DROP({1;2;3}, 0)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    }
  },
  {
    "id": "fn.drop.zero-both",
    "description": "Explicit 0,0 returns the original array",
    "tags": ["drop", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=DROP({1;2}, 0, 0)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }]
      ]
    }
  },
