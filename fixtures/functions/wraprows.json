    "id": "fn.wraprows.wrap-error-propagates",
    "description": "Error wrap_count propagates",
    "tags": ["wraprows", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=WRAPROWS({1,2,3}, #N/A)",
