  },
  {
    "id": "fn.wraprows.error-ltr-vector-wins",
    "description": "Left-to-right: vector error wins over wrap_count error",
    "tags": ["wraprows", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=WRAPROWS(#DIV/0!, #VALUE!)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.wraprows.pad-error-is-value",
    "description": "An error pad_with is written into leftover cells",
