    "tags": ["wraprows", "errors", "size"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1}, 16385)",
    "expected": { "error": "#NUM!" }
  },
  {
    "id": "fn.wraprows.over-huge-wrap-num",
    "description": "A huge wrap_count is #NUM! (would not fit a worksheet)",
    "tags": ["wraprows", "errors", "size"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1}, 1E9)",
    "expected": { "error": "#NUM!" }
  },
  {
    "id": "fn.wraprows.scalar-error-propagates",
    "description": "A scalar error vector is the function result, not a 1-cell wrap",
    "tags": ["wraprows", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=WRAPROWS(#DIV/0!, 2)",
    "expected": { "error": "#DIV/0!" }
  },
