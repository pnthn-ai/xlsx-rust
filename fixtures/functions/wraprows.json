[
  {
    "id": "fn.wraprows.row-basic",
    "description": "WRAPROWS of a row fills left-to-right, then next row",
    "tags": ["wraprows", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2,3,4,5,6}, 3)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }, { "number": 3 }],
        [{ "number": 4 }, { "number": 5 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.wraprows.col-basic",
    "description": "A column flattens top-to-bottom, then wraps by rows",
    "tags": ["wraprows", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1;2;3;4;5;6}, 2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }],
        [{ "number": 5 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.wraprows.default-pad-na",
    "description": "Omitted pad_with fills the short last row with #N/A",
    "tags": ["wraprows", "errors", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2,3,4,5}, 2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }],
        [{ "number": 5 }, { "error": "#N/A" }]
      ]
    }
  },
  {
    "id": "fn.wraprows.pad-zero",
    "description": "pad_with 0 fills the leftover cell",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2,3}, 2, 0)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 0 }]
      ]
    }
  },
  {
    "id": "fn.wraprows.pad-text",
    "description": "pad_with text (Microsoft example style)",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({\"A\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\"}, 3, \"x\")",
    "expected": {
      "array": [
        [{ "text": "A" }, { "text": "B" }, { "text": "C" }],
        [{ "text": "D" }, { "text": "E" }, { "text": "F" }],
        [{ "text": "G" }, { "text": "x" }, { "text": "x" }]
      ]
    }
  },
  {
    "id": "fn.wraprows.ms-example-na",
    "description": "Microsoft example 1: 7-wide row wrapped to 3 columns, last two #N/A",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(A2:G2, 3)",
    "expected": {
      "array": [
        [{ "text": "A" }, { "text": "B" }, { "text": "C" }],
        [{ "text": "D" }, { "text": "E" }, { "text": "F" }],
        [{ "text": "G" }, { "error": "#N/A" }, { "error": "#N/A" }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A2": { "text": "A" },
          "B2": { "text": "B" },
          "C2": { "text": "C" },
          "D2": { "text": "D" },
          "E2": { "text": "E" },
          "F2": { "text": "F" },
          "G2": { "text": "G" }
        }
      }]
    }
  },
  {
    "id": "fn.wraprows.wrap-ge-n-one-row",
    "description": "wrap_count >= n is a single row, padded out to wrap_count",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2,3}, 5, \"-\")",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }, { "text": "-" }, { "text": "-" }]]
    }
  },
  {
    "id": "fn.wraprows.exact-multiple",
    "description": "Exact multiple of wrap_count needs no pad",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2,3}, 3)",
    "expected": { "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }]] }
  },
  {
    "id": "fn.wraprows.scalar-wrap-one",
    "description": "A scalar with wrap_count 1 is a 1×1 array",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(5, 1)",
    "expected": { "array": [[{ "number": 5 }]] }
  },
  {
    "id": "fn.wraprows.scalar-padded",
    "description": "A scalar with wrap_count 2 is value + #N/A",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(5, 2)",
    "expected": { "array": [[{ "number": 5 }, { "error": "#N/A" }]] }
  },
  {
    "id": "fn.wraprows.range-col",
    "description": "WRAPROWS of a sheet column",
    "tags": ["wraprows", "functions"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(A1:A5, 2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }],
        [{ "number": 5 }, { "error": "#N/A" }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "A4": { "number": 4 },
          "A5": { "number": 5 }
        }
      }]
    }
  },
  {
    "id": "fn.wraprows.keeps-blanks",
    "description": "Blank cells in the vector are kept, not skipped",
    "tags": ["wraprows", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=WRAPROWS(A1:A4, 2, 0)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "empty": null }],
        [{ "number": 3 }, { "text": "a" }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A3": { "number": 3 },
          "A4": { "text": "a" }
        }
      }]
    }
  },
  {
    "id": "fn.wraprows.keeps-types",
    "description": "Numbers, text, logicals stay distinct in the grid",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,\"1\",TRUE}, 2, FALSE)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "text": "1" }],
        [{ "bool": true }, { "bool": false }]
      ]
    }
  },
  {
    "id": "fn.wraprows.in-array-error-kept",
    "description": "An error inside a 1-D vector is a result cell, not a function error",
    "tags": ["wraprows", "errors", "array"],
    "quirks": ["array-eval-mode", "error-precedence"],
    "formula": "=WRAPROWS({#DIV/0!, 1, 2}, 2)",
    "expected": {
      "array": [
        [{ "error": "#DIV/0!" }, { "number": 1 }],
        [{ "number": 2 }, { "error": "#N/A" }]
      ]
    }
  },
  {
    "id": "fn.wraprows.2d-value",
    "description": "A 2-D block is not a vector → #VALUE!",
    "tags": ["wraprows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS({1,2;3,4}, 2)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.wraprows.2d-range-value",
