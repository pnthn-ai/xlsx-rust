    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.wraprows.arity-empty",
    "description": "No arguments is #VALUE!",
    "tags": ["wraprows", "errors"],
    "formula": "=WRAPROWS()",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.wraprows.arity-extra",
    "description": "Four arguments is #VALUE!",
    "tags": ["wraprows", "errors"],
    "formula": "=WRAPROWS({1,2}, 2, 0, 1)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.wraprows.index-cell",
    "description": "INDEX picks a WRAPROWS cell without writing a spill range",
    "tags": ["wraprows", "index"],
    "quirks": ["array-eval-mode"],
    "formula": "=INDEX(WRAPROWS({1,2,3,4,5}, 2), 3, 1)",
    "expected": { "number": 5 }
  },
  {
    "id": "fn.wraprows.sum-with-numeric-pad",
    "description": "SUM consumes the WRAPROWS array when pads are numeric",
    "tags": ["wraprows", "sum"],
    "quirks": ["array-eval-mode"],
    "formula": "=SUM(WRAPROWS({1,2,3}, 2, 0))",
    "expected": { "number": 6 }
  },
  {
    "id": "fn.wraprows.sum-default-pad-na",
    "description": "SUM of default-padded WRAPROWS is #N/A (pad is an error)",
    "tags": ["wraprows", "sum", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=SUM(WRAPROWS({1,2,3}, 2))",
    "expected": { "error": "#N/A" }
  },
  {
    "id": "fn.wraprows.counta",
    "description": "COUNTA counts padded cells too (including #N/A)",
    "tags": ["wraprows", "counta"],
    "quirks": ["array-eval-mode"],
    "formula": "=COUNTA(WRAPROWS({1,2,3}, 2))",
    "expected": { "number": 4 }
  },
  {
    "id": "fn.wraprows.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — WRAPROWS returns the array",
    "notes": "Excel would #SPILL! if WRAPROWS at B1 needed B2:C3. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["wraprows", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(A1:A4, 2)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "A4": { "number": 4 },
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
    "id": "fn.wraprows.scalar-plus-top-left",
    "description": "WRAPROWS+n in a scalar operator takes the top-left cell (not host-aware spill intersection)",
    "notes": "The engine scalarizes arrays to the first element. It does not intersect a written spill with the host cell.",
    "tags": ["wraprows", "arithmetic"],
    "quirks": ["array-eval-mode", "implicit-intersection"],
    "formula": "=WRAPROWS({10,20,30}, 2)+1",
    "expected": { "number": 11 }
  },
  {
    "id": "fn.wraprows.dynamic-array-mode",
    "description": "array_mode=dynamic-array still returns the WRAPROWS array (no grid write)",
    "tags": ["wraprows", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPROWS(A1:A4, 2)",
    "options": { "array_mode": "dynamic-array" },
    "expected": {
      "array": [
        [{ "number": 10 }, { "number": 20 }],
        [{ "number": 30 }, { "number": 40 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 10 },
          "A2": { "number": 20 },
          "A3": { "number": 30 },
          "A4": { "number": 40 }
        }
      }]
    }
  },
  {
    "id": "fn.wraprows.pad-blank-cell",
    "description": "A blank pad_with cell pads with empty, not #N/A",
    "tags": ["wraprows", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=WRAPROWS({1,2,3}, 2, B1)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "empty": null }]
      ]
    }
  }
