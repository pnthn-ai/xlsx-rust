          "B2": { "number": 5 }
        }
      }]
    }
  },
  {
    "id": "fn.sumproduct.bool-uncoerced",
    "description": "Uncoerced TRUE/FALSE in SUMPRODUCT are treated as 0",
    "tags": ["sumproduct", "functions", "array"],
    "quirks": ["array-eval-mode", "bool-number-equality"],
    "formula": "=SUMPRODUCT({TRUE,FALSE,TRUE})",
    "expected": { "number": 0 }
  },
  {
    "id": "fn.sumproduct.bool-double-unary",
    "description": "--TRUE/--FALSE coerces logicals to 1/0 before the sum",
    "tags": ["sumproduct", "functions", "array"],
    "quirks": ["array-eval-mode", "percent-unary", "bool-number-equality"],
    "formula": "=SUMPRODUCT({--TRUE,--FALSE,--TRUE})",
    "expected": { "number": 2 }
  },
  {
    "id": "fn.sumproduct.bool-times-one",
    "description": "TRUE/FALSE * 1 inside SUMPRODUCT becomes 1/0",
    "tags": ["sumproduct", "functions", "array"],
    "quirks": ["array-eval-mode", "bool-number-equality"],
    "formula": "=SUMPRODUCT({TRUE,FALSE,TRUE}*{1,1,1})",
    "expected": { "number": 2 }
  },
  {
    "id": "fn.sumproduct.bool-times-values",
    "description": "Boolean mask * values: TRUE*10 + FALSE*20 + TRUE*30",
    "tags": ["sumproduct", "functions", "array"],
    "quirks": ["array-eval-mode", "bool-number-equality"],
    "formula": "=SUMPRODUCT({TRUE,FALSE,TRUE}*{10,20,30})",
    "expected": { "number": 40 }
  },
  {
    "id": "fn.sumproduct.text-is-zero",
