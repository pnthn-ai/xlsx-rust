[
  {
    "id": "fn.sumifs.one-pair",
    "description": "Three-arg SUMIFS is SUMIF with reversed range order",
    "tags": ["sumifs", "functions"],
    "formula": "=SUMIFS(B1:B3, A1:A3, \">2\")",
    "expected": { "number": 50 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 6 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumifs.and-two",
    "description": "Two criteria pairs are AND: both must match",
    "tags": ["sumifs"],
    "formula": "=SUMIFS(C1:C3, A1:A3, \">1\", B1:B3, \"x\")",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "text": "x" }, "C1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "text": "x" }, "C2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "text": "y" }, "C3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumifs.and-three",
    "description": "Three criteria pairs AND together",
