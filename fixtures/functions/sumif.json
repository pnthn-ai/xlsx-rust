        }
      }]
    }
  },
  {
    "id": "fn.sumif.blank-not-gt",
    "description": "Blanks are not numbers, so they miss >0",
    "tags": ["sumif"],
    "quirks": ["empty-cell-duality"],
    "formula": "=SUMIF(A1:A2, \">0\", B1:B2)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "B1": { "number": 10 },
