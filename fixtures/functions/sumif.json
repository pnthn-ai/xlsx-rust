  {
    "id": "fn.sumif.blank-not-zero",
    "description": "Blank does not match numeric 0",
    "tags": ["sumif"],
    "quirks": ["empty-cell-duality"],
    "formula": "=SUMIF(A1:A3, 0, B1:B3)",
    "expected": { "number": 10 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 0 }, "B1": { "number": 10 },
