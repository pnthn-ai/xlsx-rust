        }
      }]
    }
  },
  {
    "id": "fn.sumif.shape-extend-from-origin",
    "description": "sum_range is reshaped from its top-left to match range",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, \">1\", B1)",
    "expected": { "number": 50 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.shape-wider-ignored",
    "description": "Extra columns on a larger sum_range are ignored",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A2, \">0\", B1:C3)",
    "expected": { "number": 30 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 }, "C1": { "number": 100 },
          "A2": { "number": 2 }, "B2": { "number": 20 }, "C2": { "number": 200 },
          "B3": { "number": 99 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.shape-2d",
    "description": "2-D range walks row-major and reshapes sum_range from C1",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:B2, \">2\", C1)",
    "expected": { "number": 70 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 2 },
          "A2": { "number": 3 }, "B2": { "number": 4 },
          "C1": { "number": 10 }, "D1": { "number": 20 },
          "C2": { "number": 30 }, "D2": { "number": 40 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.bool-not-gt",
    "description": "TRUE is not a number for >0",
    "tags": ["sumif"],
    "quirks": ["bool-number-equality"],
    "formula": "=SUMIF(A1:A2, \">0\", B1:B2)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "bool": true }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.bool-eq",
    "description": "Boolean criteria matches only that logical",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A2, TRUE, B1:B2)",
    "expected": { "number": 10 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "bool": true }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.text-true-not-bool",
    "description": "Text \"TRUE\" does not match boolean TRUE",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A2, \"TRUE\", B1:B2)",
    "expected": { "number": 0 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "bool": true }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.text-num-not-gt",
    "description": "Numeric text is not coerced for > comparisons",
    "tags": ["sumif"],
    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=SUMIF(A1:A2, \">5\", B1:B2)",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "10" }, "B1": { "number": 1 },
          "A2": { "number": 10 }, "B2": { "number": 2 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.sum-skips-text",
    "description": "Matched sum cells that are text are skipped (like SUM)",
    "tags": ["sumif"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUMIF(A1:A2, 1, B1:B2)",
    "expected": { "number": 5 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "text": "x" },
          "A2": { "number": 1 }, "B2": { "number": 5 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.error-in-sum",
    "description": "Error in a matched sum cell propagates",
    "tags": ["sumif", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SUMIF(A1:A2, 1, B1:B2)",
    "expected": { "error": "#DIV/0!" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "error": "#DIV/0!" },
          "A2": { "number": 2 }, "B2": { "number": 5 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.error-in-range-skip",
    "description": "Error in the criteria range does not match >0 and is skipped",
    "tags": ["sumif", "errors"],
    "formula": "=SUMIF(A1:A2, \">0\", B1:B2)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "error": "#N/A" }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.error-criteria-propagates",
    "description": "An error criteria value is returned immediately",
    "tags": ["sumif", "errors"],
    "formula": "=SUMIF(A1:A1, #N/A, B1:B1)",
    "expected": { "error": "#N/A" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.error-text-matches",
    "description": "Text \"#N/A\" matches an #N/A cell in the criteria range",
    "tags": ["sumif", "errors"],
    "formula": "=SUMIF(A1:A2, \"#N/A\", B1:B2)",
    "expected": { "number": 10 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "error": "#N/A" }, "B1": { "number": 10 },
          "A2": { "number": 2 }, "B2": { "number": 20 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.array-is-value",
    "description": "SUMIF requires a range; array literals are #VALUE!",
    "tags": ["sumif", "errors"],
    "formula": "=SUMIF({1,2,3}, \">1\")",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.sumif.arity-value",
    "description": "SUMIF with one argument is #VALUE!",
    "tags": ["sumif", "errors"],
    "formula": "=SUMIF(A1:A2)",
    "expected": { "error": "#VALUE!" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": { "A1": { "number": 1 } }
      }]
    }
  },
  {
    "id": "fn.sumif.named-range",
    "description": "Defined name that refers to a range is accepted",
    "tags": ["sumif", "named"],
    "formula": "=SUMIF(Vals, \">1\")",
    "expected": { "number": 5 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 }
        }
      }],
      "names": [{ "name": "Vals", "refers_to": "Sheet1!A1:A3" }]
    }
  },
  {
    "id": "fn.sumif.concat-criteria",
    "description": "Criteria can be built with & (e.g. \">\"&2)",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, \">\"&2)",
    "expected": { "number": 6 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 6 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.cell-criteria",
    "description": "Criteria taken from a cell (numeric)",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, C1, B1:B3)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 6 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 },
          "C1": { "text": ">2" }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.no-matches-zero",
    "description": "No matches returns 0, not #N/A",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, \">100\")",
    "expected": { "number": 0 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.ne-text",
    "description": "<>apple matches numbers and other text",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, \"<>apple\", B1:B3)",
    "expected": { "number": 50 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "apple" }, "B1": { "number": 10 },
