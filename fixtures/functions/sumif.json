[
  {
    "id": "fn.sumif.gt-same-range",
    "description": "Two-arg SUMIF sums values in range that are > 2",
    "tags": ["sumif", "functions"],
    "formula": "=SUMIF(A1:A3, \">2\")",
    "expected": { "number": 6 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 6 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.gt-sum-range",
    "description": "Three-arg SUMIF applies criteria to range and sums sum_range",
    "tags": ["sumif", "functions"],
    "formula": "=SUMIF(A1:A3, \">2\", B1:B3)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 6 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.eq-number",
    "description": "Numeric criteria matches numbers only",
    "tags": ["sumif"],
    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=SUMIF(A1:A3, 5, B1:B3)",
    "expected": { "number": 10 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 }, "B1": { "number": 10 },
          "A2": { "text": "5" }, "B2": { "number": 20 },
          "A3": { "number": 1 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.text-num-dual",
    "description": "Text criteria \"5\" matches number 5 and text 5",
    "tags": ["sumif"],
    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=SUMIF(A1:A3, \"5\", B1:B3)",
    "expected": { "number": 30 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 }, "B1": { "number": 10 },
          "A2": { "text": "5" }, "B2": { "number": 20 },
          "A3": { "number": 1 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.eq-op-num",
    "description": "\"=5\" is the same dual match as text \"5\"",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A3, \"=5\", B1:B3)",
    "expected": { "number": 30 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 }, "B1": { "number": 10 },
          "A2": { "text": "5" }, "B2": { "number": 20 },
          "A3": { "number": 1 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.ge-le-ne",
    "description": ">= / <= / <> numeric operators",
    "tags": ["sumif"],
    "formula": "=SUMIF(A1:A4, \">=3\")+SUMIF(A1:A4, \"<=1\")+SUMIF(A1:A4, \"<>2\")",
    "expected": { "number": 16 },
    "notes": "A=1,2,3,4. >=3 → 7; <=1 → 1; <>2 → 8; 7+1+8=16",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "A4": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.text-eq-casefold",
    "description": "Text equality is case-insensitive",
    "tags": ["sumif"],
    "quirks": ["case-insensitive-text"],
    "formula": "=SUMIF(A1:A3, \"apple\", B1:B3)",
    "expected": { "number": 5 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "Apple" }, "B1": { "number": 1 },
          "A2": { "text": "banana" }, "B2": { "number": 2 },
          "A3": { "text": "APPLE" }, "B3": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.wildcard-star",
    "description": "* wildcard matches text containing a substring",
    "tags": ["sumif"],
    "quirks": ["wildcards"],
    "formula": "=SUMIF(A1:A3, \"*at*\", B1:B3)",
    "expected": { "number": 3 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "cat" }, "B1": { "number": 1 },
          "A2": { "text": "catch" }, "B2": { "number": 2 },
          "A3": { "text": "dog" }, "B3": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.wildcard-qmark",
    "description": "? wildcard matches exactly one character",
    "tags": ["sumif"],
    "quirks": ["wildcards"],
    "formula": "=SUMIF(A1:A3, \"a?\", B1:B3)",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a" }, "B1": { "number": 1 },
          "A2": { "text": "ab" }, "B2": { "number": 2 },
          "A3": { "text": "abc" }, "B3": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.wildcard-escape",
    "description": "~* matches a literal asterisk",
    "tags": ["sumif"],
    "quirks": ["wildcards"],
    "formula": "=SUMIF(A1:A3, \"a~*\", B1:B3)",
    "expected": { "number": 1 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a*" }, "B1": { "number": 1 },
          "A2": { "text": "ab" }, "B2": { "number": 2 },
          "A3": { "text": "aX" }, "B3": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.wildcard-star-skips-numbers",
    "description": "* matches text only, not numbers or blanks",
    "tags": ["sumif"],
    "quirks": ["wildcards"],
    "formula": "=SUMIF(A1:A3, \"*\", B1:B3)",
    "expected": { "number": 20 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 }, "B1": { "number": 10 },
          "A2": { "text": "x" }, "B2": { "number": 20 },
          "A3": { "number": 1 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.sumif.not-wildcard",
    "description": "<>* matches non-text (numbers, blanks)",
    "tags": ["sumif"],
    "quirks": ["wildcards"],
    "formula": "=SUMIF(A1:A3, \"<>*\", B1:B3)",
    "expected": { "number": 40 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 }, "B1": { "number": 10 },
          "A2": { "text": "x" }, "B2": { "number": 20 },
          "B3": { "number": 30 }
        }
      }]
    }
  },
  {
