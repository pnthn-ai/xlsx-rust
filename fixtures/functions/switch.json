  {
    "id": "fn.switch-wildcard-literal-star",
    "description": "SWITCH does not treat * as a MATCH/VLOOKUP wildcard",
    "tags": ["switch"],
    "quirks": ["wildcards"],
    "formula": "=SWITCH(\"abc\", \"a*\", \"wild\", \"no\")",
    "expected": { "text": "no" }
  },
  {
    "id": "fn.switch-wildcard-literal-question",
    "description": "? is a literal character, not a single-char wildcard",
    "tags": ["switch"],
    "quirks": ["wildcards"],
    "formula": "=SWITCH(\"abc\", \"a?c\", \"wild\", \"no\")",
    "expected": { "text": "no" }
  },
  {
    "id": "fn.switch-wildcard-literal-hit",
    "description": "A literal asterisk in the expression matches a literal asterisk value",
    "tags": ["switch"],
    "quirks": ["wildcards"],
    "formula": "=SWITCH(\"a*\", \"a*\", \"lit\")",
    "expected": { "text": "lit" }
  },
  {
    "id": "fn.switch-short-unused-result",
    "description": "Unused result of a later pair is not evaluated (1/0 stays inert)",
    "tags": ["switch", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=SWITCH(1, 1, \"ok\", 2, 1/0)",
    "expected": { "text": "ok" }
  },
  {
    "id": "fn.switch-short-unused-earlier-result",
    "description": "Unused result of an earlier non-matching pair is not evaluated",
    "tags": ["switch", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=SWITCH(1, 2, 1/0, 1, \"ok\")",
    "expected": { "text": "ok" }
  },
  {
    "id": "fn.switch-short-unused-default",
    "description": "Default is not evaluated when a pair matches",
    "tags": ["switch", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=SWITCH(1, 1, \"ok\", 1/0)",
    "expected": { "text": "ok" }
  },
  {
    "id": "fn.switch-default-error-when-miss",
    "description": "Default is evaluated on a miss: 1/0 → #DIV/0!",
    "tags": ["switch", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=SWITCH(9, 1, \"ok\", 1/0)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.switch-value-error-propagates",
    "description": "Error in a compared value propagates (does not skip to the next pair)",
    "tags": ["switch", "errors"],
    "quirks": ["error-precedence", "if-short-circuit"],
    "formula": "=SWITCH(1, 1/0, \"a\", 1, \"b\")",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.switch-later-value-error-after-miss",
    "description": "A later value error still fires after an earlier non-match",
    "tags": ["switch", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SWITCH(1, 2, \"a\", 1/0, \"b\")",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.switch-expr-error-not-default",
    "description": "Expression error propagates; default is not a catch-all like IFERROR",
    "tags": ["switch", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SWITCH(1/0, 1, \"a\", \"default\")",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.switch-expr-na-not-matchable",
    "description": "SWITCH(#N/A, #N/A, \"yes\", \"default\") is #N/A — the error never reaches matching",
    "tags": ["switch", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SWITCH(NA(), NA(), \"yes\", \"default\")",
    "expected": { "error": "#N/A" }
  },
  {
    "id": "fn.switch-matched-result-error",
    "description": "The chosen result is evaluated: SWITCH(1, 1, 1/0) is #DIV/0!",
    "tags": ["switch", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=SWITCH(1, 1, 1/0)",
    "expected": { "error": "#DIV/0!" }
  },
  {
