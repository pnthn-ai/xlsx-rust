  },
  {
    "id": "fn.switch-text-number-same-type",
    "description": "SWITCH(\"2\", \"2\", \"yes\") matches same-type text",
    "tags": ["switch"],
    "formula": "=SWITCH(\"2\", \"2\", \"yes\", 2, \"coerced\")",
    "expected": { "text": "yes" }
  },
  {
