    "tags": ["switch", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=SWITCH(A1, \"\", \"empty\", 0, \"zero\")",
    "expected": { "text": "empty" },
    "workbook": {
      "sheets": [{ "name": "Sheet1", "cells": {} }]
    }
  },
  {
    "id": "fn.switch-zero-not-empty-text",
    "description": "0=\"\" is FALSE, so SWITCH(0, \"\", \"empty\", \"other\") is \"other\"",
    "tags": ["switch", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=SWITCH(0, \"\", \"empty\", \"other\")",
    "expected": { "text": "other" }
  },
  {
    "id": "fn.switch-stored-empty-text",
    "description": "Stored \"\" is text, not blank: SWITCH(\"\", 0, \"zero\", \"\", \"empty\") is \"empty\"",
    "tags": ["switch", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=SWITCH(A1, 0, \"zero\", \"\", \"empty\")",
    "expected": { "text": "empty" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": { "A1": { "text": "" } }
      }]
    }
