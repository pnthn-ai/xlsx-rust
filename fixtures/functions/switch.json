[
  {
    "id": "fn.switch-basic",
    "description": "SWITCH(2, 1, \"one\", 2, \"two\", 3, \"three\") is \"two\"",
    "tags": ["switch", "logical"],
    "formula": "=SWITCH(2, 1, \"one\", 2, \"two\", 3, \"three\")",
    "expected": { "text": "two" }
  },
  {
    "id": "fn.switch-first-pair",
    "description": "First pair matches",
    "tags": ["switch"],
    "formula": "=SWITCH(1, 1, \"one\", 2, \"two\")",
    "expected": { "text": "one" }
  },
  {
    "id": "fn.switch-last-pair",
    "description": "Last pair matches",
    "tags": ["switch"],
    "formula": "=SWITCH(3, 1, \"one\", 2, \"two\", 3, \"three\")",
    "expected": { "text": "three" }
  },
  {
    "id": "fn.switch-first-match-wins",
    "description": "Duplicate values: first match wins",
    "tags": ["switch"],
    "formula": "=SWITCH(1, 1, \"first\", 1, \"second\")",
    "expected": { "text": "first" }
  },
  {
    "id": "fn.switch-default",
    "description": "Unpaired last argument is the default",
    "tags": ["switch"],
    "formula": "=SWITCH(9, 1, \"one\", 2, \"two\", \"none\")",
    "expected": { "text": "none" }
  },
  {
    "id": "fn.switch-weekday-style",
    "description": "Microsoft-style weekday map with a default (WEEKDAY serial 2 → Monday)",
    "tags": ["switch"],
    "formula": "=SWITCH(2, 1, \"Sunday\", 2, \"Monday\", 3, \"Tuesday\", 4, \"Wednesday\", 5, \"Thursday\", 6, \"Friday\", 7, \"Saturday\", \"No match\")",
    "expected": { "text": "Monday" }
  },
  {
    "id": "fn.switch-weekday-default",
    "description": "Weekday-style SWITCH falls through to default",
    "tags": ["switch"],
    "formula": "=SWITCH(9, 1, \"Sunday\", 2, \"Monday\", 3, \"Tuesday\", \"No match\")",
    "expected": { "text": "No match" }
  },
  {
    "id": "fn.switch-no-match-na",
    "description": "No match and no default is #N/A (unlike a nested IF missing an else, which is FALSE)",
    "tags": ["switch", "errors"],
    "formula": "=SWITCH(9, 1, \"one\", 2, \"two\")",
    "expected": { "error": "#N/A" }
  },
  {
    "id": "fn.switch-vs-if-missing-else",
    "description": "IF(9=1, \"one\", IF(9=2, \"two\")) is FALSE; SWITCH of the same pairs is #N/A",
    "tags": ["switch", "if"],
    "formula": "=IF(9=1, \"one\", IF(9=2, \"two\"))",
    "expected": { "bool": false }
  },
  {
    "id": "fn.switch-vs-if-truthy-two",
    "description": "IF(2, \"yes\", \"no\") is \"yes\" (nonzero is true); SWITCH does not treat 2 as TRUE",
    "tags": ["switch", "if"],
    "formula": "=IF(2, \"yes\", \"no\")",
    "expected": { "text": "yes" }
  },
  {
    "id": "fn.switch-not-if-truthiness",
    "description": "SWITCH(2, TRUE, \"yes\", \"no\") is \"no\" — exact match, not IF truthiness",
    "tags": ["switch", "if"],
    "quirks": ["bool-number-equality"],
    "formula": "=SWITCH(2, TRUE, \"yes\", \"no\")",
    "expected": { "text": "no" }
  },
  {
    "id": "fn.switch-true-eq-one",
    "description": "SWITCH(TRUE, 1, \"num\") matches because TRUE=1",
    "tags": ["switch"],
    "quirks": ["bool-number-equality"],
    "formula": "=SWITCH(TRUE, 1, \"num\", TRUE, \"bool\")",
    "expected": { "text": "num" }
  },
  {
    "id": "fn.switch-true-literal-second",
    "description": "SWITCH(TRUE, TRUE, \"bool\", 1, \"num\") hits the TRUE pair first",
    "tags": ["switch"],
    "quirks": ["bool-number-equality"],
    "formula": "=SWITCH(TRUE, TRUE, \"bool\", 1, \"num\")",
    "expected": { "text": "bool" }
  },
  {
    "id": "fn.switch-one-eq-true",
    "description": "SWITCH(1, TRUE, \"yes\") matches (1=TRUE)",
    "tags": ["switch"],
    "quirks": ["bool-number-equality"],
    "formula": "=SWITCH(1, TRUE, \"yes\", \"no\")",
    "expected": { "text": "yes" }
  },
  {
    "id": "fn.switch-false-eq-zero",
    "description": "SWITCH(FALSE, 0, \"zero\") matches because FALSE=0",
    "tags": ["switch"],
    "quirks": ["bool-number-equality"],
    "formula": "=SWITCH(FALSE, 0, \"zero\")",
    "expected": { "text": "zero" }
  },
  {
