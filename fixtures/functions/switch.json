    "formula": "=SWITCH(\"A\", \"a\", \"yes\", \"no\")",
    "expected": { "text": "yes" }
  },
  {
    "id": "fn.switch-casefold-mixed",
    "description": "SWITCH(\"AbC\", \"abc\", \"yes\") matches",
    "tags": ["switch"],
    "quirks": ["case-insensitive-text"],
    "formula": "=SWITCH(\"AbC\", \"abc\", \"yes\")",
    "expected": { "text": "yes" }
  },
  {
    "id": "fn.switch-ieee",
