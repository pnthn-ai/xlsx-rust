  {
    "id": "fn.wrapcols.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — WRAPCOLS returns the array",
    "notes": "Excel would #SPILL! if WRAPCOLS at B1 needed B2. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["wrapcols", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS(A1:A4,2)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }],
        [{ "number": 2 }, { "number": 4 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "A4": { "number": 4 },
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
    "id": "fn.wrapcols.scalar-plus-top-left",
    "description": "WRAPCOLS+n in a scalar operator takes the top-left element (not host-aware spill intersection)",
    "notes": "The engine scalarizes arrays to the first element. It does not intersect a written spill with the host cell.",
    "tags": ["wrapcols", "arithmetic"],
    "quirks": ["array-eval-mode", "implicit-intersection"],
    "formula": "=WRAPCOLS({10,20,30,40},2)+1",
    "expected": { "number": 11 }
  },
  {
    "id": "fn.wrapcols.wrap-count-array-scalarize",
    "description": "A 1×1 array wrap_count scalarizes",
    "tags": ["wrapcols", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4},{2})",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }],
        [{ "number": 2 }, { "number": 4 }]
      ]
    }
  },
  {
    "id": "fn.wrapcols.two-d-and-bad-wrap-count",
    "description": "Invalid wrap_count is reported even when vector is also 2-D",
    "tags": ["wrapcols", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2;3,4},0)",
    "expected": { "error": "#NUM!" }
  },
  {
    "id": "fn.wrapcols.spill-occupancy-not-modeled",
    "description": "#SPILL! from a blocked spill range is not produced",
    "tags": ["wrapcols"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4},2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }],
        [{ "number": 2 }, { "number": 4 }]
      ]
    },
    "ignore": "Workbook snippets have no spill grid. WRAPCOLS returns an array value; #SPILL! from occupied cells below/right of the host is not modeled."
  },
  {
    "id": "fn.wrapcols.excel-size-cap-not-enforced",
    "description": "Excel's 1,048,576-row / 16,384-column array caps are not enforced",
    "tags": ["wrapcols"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3},2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }],
        [{ "number": 2 }, { "error": "#N/A" }]
      ]
    },
    "ignore": "A WRAPCOLS result taller than 1,048,576 rows or wider than 16,384 columns would be #NUM! in live Excel. This engine is memory-bounded and does not emit #NUM! for oversized WRAPCOLS results."
  }
]
