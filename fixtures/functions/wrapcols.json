[
  {
    "id": "fn.wrapcols.row-basic",
    "description": "WRAPCOLS fills down columns then wraps to the right",
    "tags": ["wrapcols", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4,5,6},2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }, { "number": 5 }],
        [{ "number": 2 }, { "number": 4 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.wrapcols.col-basic",
    "description": "A column vector wraps in the same sequential order as a row",
    "tags": ["wrapcols", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1;2;3;4;5;6},2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }, { "number": 5 }],
        [{ "number": 2 }, { "number": 4 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.wrapcols.wrap-three",
    "description": "wrap_count is the column height, not the number of columns",
    "tags": ["wrapcols", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4,5,6},3)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 4 }],
        [{ "number": 2 }, { "number": 5 }],
        [{ "number": 3 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.wrapcols.default-pad-na",
    "description": "Omitted pad_with fills the last column with #N/A",
    "tags": ["wrapcols", "errors", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4,5},2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }, { "number": 5 }],
        [{ "number": 2 }, { "number": 4 }, { "error": "#N/A" }]
      ]
    }
  },
  {
    "id": "fn.wrapcols.pad-text",
    "description": "pad_with replaces leftover cells in the last column",
    "tags": ["wrapcols", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=WRAPCOLS({1,2,3,4,5},2,\"x\")",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }, { "number": 5 }],
        [{ "number": 2 }, { "number": 4 }, { "text": "x" }]
      ]
    }
  },
  {
