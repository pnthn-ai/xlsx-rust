[
  {
    "id": "fn.torow.matrix-row-major",
    "description": "TOROW of a 2×3 matrix scans left-to-right then down",
    "tags": ["torow", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({1,2,3;4,5,6})",
    "expected": {
      "array": [[
        { "number": 1 }, { "number": 2 }, { "number": 3 },
        { "number": 4 }, { "number": 5 }, { "number": 6 }
      ]]
    }
  },
  {
    "id": "fn.torow.matrix-col-major",
    "description": "scan_by_col=TRUE walks top-to-bottom then across",
    "tags": ["torow", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({1,2,3;4,5,6}, 0, TRUE)",
    "expected": {
      "array": [[
        { "number": 1 }, { "number": 4 }, { "number": 2 },
        { "number": 5 }, { "number": 3 }, { "number": 6 }
      ]]
    }
  },
  {
    "id": "fn.torow.column-to-row",
    "description": "A column becomes a single row in first-to-last order",
    "tags": ["torow", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({1;2;3})",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }]]
    }
  },
  {
    "id": "fn.torow.already-a-row",
    "description": "A row scanned by row is unchanged",
    "tags": ["torow", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({1,2,3})",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }]]
    }
  },
  {
    "id": "fn.torow.scalar-wraps",
    "description": "A scalar wraps as a 1×1 array row",
    "tags": ["torow", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW(5)",
    "expected": {
      "array": [[{ "number": 5 }]]
    }
  },
  {
    "id": "fn.torow.range-keep-all",
    "description": "Range flatten keeps blanks as empty (not 0)",
    "tags": ["torow", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:B2)",
    "expected": {
      "array": [[
        { "number": 1 }, { "empty": null },
        { "number": 3 }, { "number": 4 }
      ]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 3 },
          "B2": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.torow.range-ignore-blanks",
    "description": "ignore=1 drops empty cells and keeps numbers",
    "tags": ["torow", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:B2, 1)",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 3 }, { "number": 4 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 3 },
          "B2": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.torow.ignore-blanks-keeps-empty-string",
    "description": "Stored \"\" is text, not blank — ignore=1 keeps it",
    "tags": ["torow", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:A3, 1)",
    "expected": {
      "array": [[{ "number": 1 }, { "text": "" }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A3": { "text": "" }
        }
      }]
    }
  },
  {
    "id": "fn.torow.ignore-blanks-keeps-zero-and-false",
    "description": "0 and FALSE are values, not blanks",
    "tags": ["torow", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW({0,FALSE}, 1)",
    "expected": {
      "array": [[{ "number": 0 }, { "bool": false }]]
    }
  },
  {
    "id": "fn.torow.ignore-errors",
    "description": "ignore=2 drops errors and keeps blanks",
    "tags": ["torow", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW(A1:A3, 2)",
    "expected": {
      "array": [[{ "number": 1 }, { "empty": null }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "error": "#DIV/0!" }
        }
      }]
    }
  },
  {
    "id": "fn.torow.keep-errors-in-row",
    "description": "ignore=0 keeps error cells inside the result row",
    "tags": ["torow", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({1,#DIV/0!,3})",
    "expected": {
      "array": [[{ "number": 1 }, { "error": "#DIV/0!" }, { "number": 3 }]]
    }
  },
  {
    "id": "fn.torow.ignore-blanks-and-errors",
    "description": "ignore=3 drops blanks and errors",
    "tags": ["torow", "errors", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:B2, 3)",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 4 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "B1": { "error": "#N/A" },
          "B2": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.torow.all-ignored-is-calc",
    "description": "Every cell ignored is #CALC! (Excel cannot return an empty array)",
    "tags": ["torow", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW({#N/A;#DIV/0!}, 2)",
    "expected": { "error": "#CALC!" }
  },
  {
    "id": "fn.torow.all-blanks-ignored-is-calc",
    "description": "ignore=1 on an all-blank range is #CALC!",
    "tags": ["torow", "empty", "errors"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:B2, 1)",
    "expected": { "error": "#CALC!" },
    "workbook": {
      "sheets": [{ "name": "Sheet1", "cells": {} }]
    }
  },
  {
    "id": "fn.torow.ignore-true-is-blanks",
