  {
    "id": "fn.torow.named-range",
    "description": "TOROW of a defined-name range",
    "tags": ["torow", "functions"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOROW(Block)",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }, { "number": 4 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "B1": { "number": 2 },
          "A2": { "number": 3 },
          "B2": { "number": 4 }
        }
      }],
      "names": [{ "name": "Block", "refers_to": "Sheet1!A1:B2" }]
    }
  }
