    "formula": "=TOROW(A1:A3, TRUE)",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A3": { "number": 2 }
        }
      }]
    }
  },
  {
    "id": "fn.torow.ignore-false-keeps-all",
    "description": "FALSE coerces to ignore=0",
    "tags": ["torow", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOROW(A1:A2, FALSE)",
    "expected": {
      "array": [[{ "number": 1 }, { "empty": null }]]
    },
    "workbook": {
      "sheets": [{
