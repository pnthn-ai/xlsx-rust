    "formula": "=PROPER(A1)",
    "expected": { "text": "" }
  },
  {
    "id": "fn.proper-true",
    "description": "PROPER(TRUE) coerces TRUE → \"TRUE\" then title-cases to \"True\"",
    "tags": ["text", "proper", "coercion"],
    "formula": "=PROPER(TRUE)",
    "expected": { "text": "True" }
  },
  {
    "id": "fn.proper-false",
    "description": "PROPER(FALSE) coerces FALSE → \"FALSE\" then title-cases to \"False\"",
    "tags": ["text", "proper", "coercion"],
    "formula": "=PROPER(FALSE)",
    "expected": { "text": "False" }
  },
  {
    "id": "fn.proper-number",
    "description": "PROPER(123) coerces to text \"123\" (digits are not letters)",
    "tags": ["text", "proper", "coercion"],
    "formula": "=PROPER(123)",
    "expected": { "text": "123" }
  },
  {
    "id": "fn.proper-error",
    "description": "Error argument propagates",
    "tags": ["text", "proper", "errors"],
