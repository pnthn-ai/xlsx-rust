[
  {
    "id": "fn.pduration.ms-years",
    "description": "Microsoft PDURATION example: 2.5% to grow $2,000 to $2,200",
    "tags": ["pduration", "financial"],
    "notes": "support.microsoft.com PDURATION(2.5%, 2000, 2200) prints 3.86. Golden is the OpenFormula 6.12.32 identity log(fv/pv)/log(1+rate) in IEEE.",
    "formula": "=PDURATION(2.5%, 2000, 2200)",
    "expected": { "number": 3.859866162622648 }
  },
  {
    "id": "fn.pduration.ms-months",
    "description": "Microsoft PDURATION example: monthly 2.5% annual to grow $1,000 to $1,200",
    "tags": ["pduration", "financial"],
    "notes": "support.microsoft.com PDURATION(0.025/12, 1000, 1200) prints 87.6.",
    "formula": "=PDURATION(0.025/12, 1000, 1200)",
    "expected": { "number": 87.60547641937562 }
  },
  {
    "id": "fn.pduration.ms-cells",
    "description": "Same Microsoft yearly example via cell refs",
    "tags": ["pduration", "financial"],
    "formula": "=PDURATION(A2, A3, A4)",
    "expected": { "number": 3.859866162622648 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A2": { "number": 0.025 },
          "A3": { "number": 2000 },
          "A4": { "number": 2200 }
        }
      }]
    }
  },
  {
