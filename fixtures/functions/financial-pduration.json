    "expected": { "number": 1 }
  },
  {
    "id": "fn.pduration.two-period",
    "description": "fv = pv*(1+rate)^2 is 2 periods",
    "tags": ["pduration", "financial"],
    "formula": "=PDURATION(0.1, 100, 121)",
    "expected": { "number": 2 }
  },
  {
    "id": "fn.pduration.power-identity",
