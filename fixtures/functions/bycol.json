  {
    "id": "fn.bycol.array-return",
    "description": "LAMBDA must return a single value; a multi-cell array body cell is #CALC!",
    "tags": ["bycol", "lambda"],
    "quirks": ["array-eval-mode"],
    "formula": "=BYCOL({1,2},LAMBDA(c,{1,2}))",
    "expected": {
      "array": [[{ "error": "#CALC!" }, { "error": "#CALC!" }]]
    },
    "notes": "Excel 365 often surfaces one #CALC! (nested arrays) for the whole spill. This engine places #CALC! in each result cell so other columns still compute."
  },
