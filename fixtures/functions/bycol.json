  {
    "id": "fn.bycol.sum-2x3",
    "description": "BYCOL sums each column of a 2×3 array via LAMBDA(c,SUM(c))",
    "tags": ["bycol", "lambda", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=BYCOL({1,2,3;4,5,6},LAMBDA(c,SUM(c)))",
    "expected": {
      "array": [[{ "number": 5 }, { "number": 7 }, { "number": 9 }]]
    }
  },
