  {
    "id": "fn.scan.sum-row",
    "description": "SCAN running sum with explicit 0 initial on a row literal",
    "tags": ["scan", "lambda", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SCAN(0,{1,2,3},LAMBDA(a,v,a+v))",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 3 }, { "number": 6 }]]
    }
  },
