  {
    "id": "fn.scan.iife-lambda-not-parsed",
    "description": "Immediately-invoked LAMBDA(...)(args) is not parsed",
    "tags": ["scan", "lambda"],
    "formula": "=SCAN(0,{1},LAMBDA(a,v,a+v)(0,1))",
    "expected": { "array": [[{ "number": 1 }]] },
    "ignore": "Immediately-invoked LAMBDA(...)(args) is not in the parser. SCAN requires an inline LAMBDA(acc,value,body) or a defined name that refers to one."
  },
  {
    "id": "fn.scan.native-sum-as-lambda-not-bound",
    "description": "Excel can bind SUM as a binary LAMBDA; this engine does not",
    "tags": ["scan", "lambda"],
    "formula": "=SCAN(0,{1,2,3},SUM)",
    "expected": { "array": [[{ "number": 1 }, { "number": 3 }, { "number": 6 }]] },
    "ignore": "Excel 365 accepts some native functions (SUM) as the SCAN LAMBDA. This engine only binds an inline LAMBDA or a defined name that refers to one — same limit as MAKEARRAY."
  }
