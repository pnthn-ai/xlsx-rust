  {
    "id": "fn.take.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — TAKE returns the array",
    "notes": "Excel would #SPILL! if TAKE at B1 needed B2. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["take", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE(A1:A3, 2)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
    "id": "fn.take.scalar-plus-top-left",
    "description": "TAKE+n in a scalar operator takes the top-left (not host-aware spill intersection)",
    "notes": "The engine scalarizes arrays to the first element. It does not intersect a written spill with the host cell.",
    "tags": ["take", "arithmetic"],
    "quirks": ["array-eval-mode", "implicit-intersection"],
    "formula": "=TAKE({10;20;30}, 2)+1",
    "expected": { "number": 11 }
