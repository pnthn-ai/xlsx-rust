  {
    "id": "fn.take.omitted-middle-not-parsed",
    "description": "TAKE(array,,cols) is Excel-legal (all rows, N cols) but this parser rejects omitted middle args",
    "tags": ["take"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1,2,3;4,5,6},,2)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 4 }, { "number": 5 }]
      ]
    },
    "ignore": "Parser does not accept omitted middle arguments (TAKE(a,,2)). Excel would keep all rows and the first two columns. Use TAKE(a, rows, 2) with an oversize rows count instead. Not used to hide a broken TAKE kernel."
  },
  {
    "id": "fn.take.spill-occupancy-not-modeled",
