[
  {
    "id": "fn.take.col-first",
    "description": "TAKE of a column keeps the first N rows",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1;2;3}, 2)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }]
      ]
    }
  },
  {
    "id": "fn.take.col-last",
    "description": "Negative rows takes from the bottom",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1;2;3}, -2)",
    "expected": {
      "array": [
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    },
    "notes": "Negative count is from the end, not a drop of |n| from the start. TAKE(a,-2) of 3 rows is the last two, not the first one."
  },
  {
    "id": "fn.take.col-one",
    "description": "A single taken row is still a 1×1 array",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1;2;3}, 1)",
    "expected": {
      "array": [[{ "number": 1 }]]
    }
  },
  {
    "id": "fn.take.col-last-one",
    "description": "TAKE(..., -1) is the last row as a 1×1 array",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1;2;3}, -1)",
    "expected": {
      "array": [[{ "number": 3 }]]
    }
  },
  {
    "id": "fn.take.row-first-cols",
    "description": "Omitted rows + cols keeps the row and slices columns from the left",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1,2,3}, 1, 2)",
    "expected": {
      "array": [[{ "number": 1 }, { "number": 2 }]]
    },
    "notes": "Parser cannot express TAKE(a,,2). A 1-row array with rows=1 is the honest equivalent of omitted rows."
  },
  {
    "id": "fn.take.row-last-cols",
    "description": "Negative cols takes from the right",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1,2,3}, 1, -2)",
    "expected": {
      "array": [[{ "number": 2 }, { "number": 3 }]]
    }
  },
  {
