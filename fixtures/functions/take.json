  {
    "id": "fn.take.empty-count-calc",
    "description": "A blank count cell coerces to 0 → #CALC! (not 'omit / take all')",
    "tags": ["take", "empty", "errors"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TAKE(A1:A3, B1)",
    "expected": { "error": "#CALC!" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 }
        }
      }]
    },
    "notes": "Empty ≠ omitted. TAKE(array,,2) would keep all rows in Excel; TAKE(array, blank) is 0."
  },
