    }
  },
  {
    "id": "fn.take.fract-neg",
    "description": "-1.9 truncates toward zero to -1 (last row), not INT-style -2",
    "tags": ["take", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TAKE({1;2;3}, -1.9)",
    "expected": {
      "array": [[{ "number": 3 }]]
    },
    "notes": "Toward-zero truncate, not INT. INT(-1.9) is -2 and would take the last two rows."
  },
