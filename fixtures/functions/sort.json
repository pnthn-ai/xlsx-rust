[
  {
    "id": "fn.sort.col-asc-default",
    "description": "SORT of a column is ascending by the first (only) column",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({3;1;2})",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    }
  },
  {
    "id": "fn.sort.col-desc",
    "description": "sort_order -1 is descending",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({3;1;2}, 1, -1)",
    "expected": {
      "array": [
        [{ "number": 3 }],
        [{ "number": 2 }],
        [{ "number": 1 }]
      ]
    }
  },
  {
    "id": "fn.sort.already-sorted",
    "description": "An already-ascending column is unchanged",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({1;2;3})",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    }
  },
  {
    "id": "fn.sort.row-default-is-one-row",
    "description": "A single row sorted by rows (by_col omitted) is already one item",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({3,1,2})",
    "expected": {
      "array": [[{ "number": 3 }, { "number": 1 }, { "number": 2 }]]
    }
  },
  {
    "id": "fn.sort.row-by-col",
