        [{ "number": 1 }, { "number": 30 }]
      ]
    }
  },
  {
    "id": "fn.sort.2d-desc-index-2",
    "description": "Descending sort by column 2",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({1,30;2,10;3,20}, 2, -1)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 30 }],
        [{ "number": 3 }, { "number": 20 }],
        [{ "number": 2 }, { "number": 10 }]
      ]
    }
  },
  {
    "id": "fn.sort.2d-by-col",
    "description": "by_col=TRUE with sort_index 1 reorders columns by the first row",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORT({3,1,2;\"c\",\"a\",\"b\"}, 1, 1, TRUE)",
