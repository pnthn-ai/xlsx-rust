      ]
    }
  },
  {
    "id": "fn.sort.number-vs-text",
    "description": "Number 1 sorts before text \"1\" (type groups, not equality)",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode", "equality-vs-arithmetic-coercion"],
    "formula": "=SORT({2;\"1\";10})",
    "expected": {
      "array": [
        [{ "number": 2 }],
        [{ "number": 10 }],
        [{ "text": "1" }]
      ]
    }
  },
  {
    "id": "fn.sort.bool-vs-number",
    "description": "Numbers sort before logicals; FALSE before TRUE",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode", "bool-number-equality", "type-comparison-ranking"],
    "formula": "=SORT({TRUE;1;FALSE;0})",
    "expected": {
      "array": [
        [{ "number": 0 }],
        [{ "number": 1 }],
        [{ "bool": false }],
        [{ "bool": true }]
      ]
    }
  },
  {
    "id": "fn.sort.mixed-types-asc",
    "description": "Ascending type groups: numbers, text, FALSE/TRUE, errors; blanks last",
    "tags": ["sort", "functions", "array"],
    "quirks": ["array-eval-mode", "type-comparison-ranking", "empty-cell-duality"],
    "formula": "=SORT(A1:A8)",
    "expected": {
      "array": [
        [{ "number": 2 }],
        [{ "number": 10 }],
        [{ "text": "a" }],
        [{ "text": "b" }],
        [{ "bool": false }],
        [{ "bool": true }],
        [{ "error": "#N/A" }],
        [{ "empty": null }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "bool": true },
          "A2": { "text": "b" },
          "A3": { "number": 2 },
          "A5": { "text": "a" },
          "A6": { "error": "#N/A" },
          "A7": { "bool": false },
          "A8": { "number": 10 }
        }
      }]
    }
  },
