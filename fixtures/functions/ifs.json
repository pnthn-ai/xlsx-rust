    "tags": ["ifs", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=IFS(TRUE, #N/A, 1/0, 2)",
    "expected": { "error": "#N/A" }
  },
  {
    "id": "fn.ifs-na-condition",
