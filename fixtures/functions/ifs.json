[
  {
    "id": "fn.ifs-first-true",
    "description": "IFS returns the value of the first TRUE test",
    "tags": ["ifs", "logical"],
    "formula": "=IFS(TRUE, 1, TRUE, 2)",
    "expected": { "number": 1 }
  },
  {
    "id": "fn.ifs-later-true",
    "description": "IFS(FALSE, 1, TRUE, 2) is 2",
    "tags": ["ifs", "logical"],
    "formula": "=IFS(FALSE, 1, TRUE, 2)",
    "expected": { "number": 2 }
  },
  {
    "id": "fn.ifs-third-true",
    "description": "Third pair wins when the first two tests are FALSE",
    "tags": ["ifs", "logical"],
    "formula": "=IFS(FALSE, 1, FALSE, 2, TRUE, 3)",
    "expected": { "number": 3 }
  },
  {
    "id": "fn.ifs-no-match-na",
    "description": "IFS with every test FALSE is #N/A",
    "tags": ["ifs", "errors"],
    "formula": "=IFS(FALSE, 1, FALSE, 2)",
    "expected": { "error": "#N/A" },
    "notes": "Excel has no built-in default; unmatched IFS is #N/A, not FALSE."
  },
  {
    "id": "fn.ifs-single-false-na",
    "description": "IFS(FALSE, 1) is #N/A",
    "tags": ["ifs", "errors"],
    "formula": "=IFS(FALSE, 1)",
    "expected": { "error": "#N/A" }
  },
  {
    "id": "fn.ifs-true-default",
    "description": "TRUE as the last test is the default branch",
    "tags": ["ifs", "logical"],
    "formula": "=IFS(FALSE, 1, FALSE, 2, TRUE, 9)",
    "expected": { "number": 9 }
  },
  {
    "id": "fn.ifs-true-fn-default",
    "description": "TRUE() as the last test is also a default",
    "tags": ["ifs", "logical"],
    "formula": "=IFS(FALSE, \"a\", TRUE(), \"b\")",
    "expected": { "text": "b" }
  },
  {
    "id": "fn.ifs-no-short-unused-value-div0",
    "description": "IFS evaluates unused values: IFS(TRUE, 1, FALSE, 1/0) is #DIV/0!",
    "tags": ["ifs", "errors"],
    "quirks": ["if-short-circuit", "error-precedence"],
    "formula": "=IFS(TRUE, 1, FALSE, 1/0)",
    "expected": { "error": "#DIV/0!" },
    "notes": "Contrast with IF(TRUE, 1, 1/0) which is 1. Excel IFS does not short-circuit."
  },
  {
    "id": "fn.ifs-no-short-unused-cond-div0",
    "description": "IFS evaluates later tests: IFS(TRUE, 1, 1/0, 2) is #DIV/0!",
    "tags": ["ifs", "errors"],
    "quirks": ["if-short-circuit", "error-precedence"],
    "formula": "=IFS(TRUE, 1, 1/0, 2)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.ifs-false-pair-value-div0",
    "description": "A FALSE pair's value is still evaluated: IFS(FALSE, 1/0, TRUE, 2) is #DIV/0!",
    "tags": ["ifs", "errors"],
    "quirks": ["if-short-circuit", "error-precedence"],
    "formula": "=IFS(FALSE, 1/0, TRUE, 2)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.ifs-false-only-value-div0",
    "description": "IFS(FALSE, 1/0) is #DIV/0! (value evaluated before the no-match #N/A)",
    "tags": ["ifs", "errors"],
    "quirks": ["if-short-circuit", "error-precedence"],
    "formula": "=IFS(FALSE, 1/0)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.ifs-later-text-cond-is-value",
    "description": "A later non-logical test is #VALUE! even after a TRUE match",
    "tags": ["ifs", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=IFS(TRUE, 1, \"x\", 2)",
    "expected": { "error": "#VALUE!" },
    "notes": "Excel evaluates every logical_test. Text is not coerced."
  },
  {
    "id": "fn.ifs-if-does-short-circuit",
    "description": "Contrast: IF(TRUE, 1, 1/0) is 1",
    "tags": ["if", "ifs", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=IF(TRUE, 1, 1/0)",
    "expected": { "number": 1 }
  },
  {
    "id": "fn.ifs-condition-error",
