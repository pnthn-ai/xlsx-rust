        }
      }]
    }
  },
  {
    "id": "fn.countifs.align-offset",
    "description": "Same-shape ranges pair by offset, not by absolute address",
    "tags": ["countifs"],
    "formula": "=COUNTIFS(A1:A3, \">1\", C5:C7, \"x\")",
    "expected": { "number": 1 },
    "notes": "A2/A3 match >1; C6 is x, C7 is y → only the A2/C6 pair",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "C5": { "text": "x" },
          "C6": { "text": "x" },
          "C7": { "text": "y" }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.shape-2d",
    "description": "Matching 2-D windows walk row-major and AND by offset",
    "tags": ["countifs"],
    "formula": "=COUNTIFS(A1:B2, \">2\", C1:D2, \">15\")",
    "expected": { "number": 2 },
    "notes": "A/B = 1,2 / 3,4; C/D = 10,20 / 30,40. >2 is A2 and B2; >15 is C1 no, D1/C2/D2. AND → A2/C2 and B2/D2",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 2 },
          "A2": { "number": 3 }, "B2": { "number": 4 },
          "C1": { "number": 10 }, "D1": { "number": 20 },
          "C2": { "number": 30 }, "D2": { "number": 40 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.eq-number-matches-numeric-text",
