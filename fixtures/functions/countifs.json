[
  {
    "id": "fn.countifs.one-pair",
    "description": "Two-arg COUNTIFS is COUNTIF with range-only arguments",
    "tags": ["countifs", "functions"],
    "formula": "=COUNTIFS(A1:A3, \">2\")",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 6 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.and-two",
    "description": "Two criteria pairs are AND: both must match",
    "tags": ["countifs"],
    "formula": "=COUNTIFS(A1:A3, \">1\", B1:B3, \"x\")",
    "expected": { "number": 1 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "text": "x" },
          "A2": { "number": 2 }, "B2": { "text": "x" },
          "A3": { "number": 3 }, "B3": { "text": "y" }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.and-three",
    "description": "Three criteria pairs AND together",
    "tags": ["countifs"],
    "formula": "=COUNTIFS(A1:A4, 2, B1:B4, \"y\", C1:C4, 1)",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "text": "x" }, "C1": { "number": 1 },
          "A2": { "number": 2 }, "B2": { "text": "y" }, "C2": { "number": 1 },
          "A3": { "number": 3 }, "B3": { "text": "x" }, "C3": { "number": 1 },
          "A4": { "number": 2 }, "B4": { "text": "y" }, "C4": { "number": 1 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.and-same-range",
    "description": "Two criteria on the same range AND together",
    "tags": ["countifs"],
    "formula": "=COUNTIFS(A1:A4, \">1\", A1:A4, \"<4\")",
    "expected": { "number": 2 },
    "notes": "A=1,2,3,4. >1 AND <4 → rows 2 and 3",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "A4": { "number": 4 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.shape-mismatch-rows",
    "description": "Criteria range with a different row count is #VALUE!",
    "tags": ["countifs", "errors"],
    "formula": "=COUNTIFS(A1:A3, \">0\", B1:B2, 1)",
    "expected": { "error": "#VALUE!" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 1 },
          "A2": { "number": 2 }, "B2": { "number": 1 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.shape-mismatch-orientation",
    "description": "Same cell count but 3x1 vs 1x3 is #VALUE!",
    "tags": ["countifs", "errors"],
    "formula": "=COUNTIFS(A1:A3, \">0\", B1:D1, \">0\")",
    "expected": { "error": "#VALUE!" },
    "workbook": {
      "sheets": [{
