    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=COUNTIFS(A1:A3, \"5\")",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 },
          "A2": { "text": "5" },
          "A3": { "number": 1 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.text-eq-casefold",
