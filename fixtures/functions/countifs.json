          "A3": { "number": 3 }, "B3": { "number": 1 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.wider-range-is-value",
    "description": "Extra columns on a later range are a shape error, not ignored",
    "tags": ["countifs", "errors"],
    "formula": "=COUNTIFS(A1:A2, \">0\", B1:C2, 1)",
