    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=COUNTIFS(A1:A3, 5)",
    "expected": { "number": 2 },
    "notes": "Unlike SUMIFS(range, 5), COUNTIFS(5) also matches text \"5\"",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 5 },
          "A2": { "text": "5" },
          "A3": { "number": 1 }
        }
      }]
    }
  },
  {
    "id": "fn.countifs.text-num-dual",
