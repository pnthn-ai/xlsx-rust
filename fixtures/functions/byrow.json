[
  {
    "id": "fn.byrow.sum-3x2",
    "description": "BYROW sums each row of a 2×3 range (Microsoft-shaped)",
    "tags": ["byrow", "lambda", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=BYROW(A1:C2,LAMBDA(row,SUM(row)))",
    "expected": {
      "array": [
        [{ "number": 6 }],
        [{ "number": 15 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "B1": { "number": 2 },
          "C1": { "number": 3 },
          "A2": { "number": 4 },
          "B2": { "number": 5 },
          "C2": { "number": 6 }
        }
      }]
    }
  },
