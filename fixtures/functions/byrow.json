  {
    "id": "fn.byrow.spill-occupancy-not-modeled",
    "description": "#SPILL! from a blocked spill range is not produced",
    "tags": ["byrow"],
    "quirks": ["array-eval-mode"],
    "formula": "=BYROW({1;2},LAMBDA(r,SUM(r)))",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 2 }]] },
    "ignore": "Workbook snippets have no spill grid. BYROW returns an array value; #SPILL! from occupied cells below the host is not modeled."
  },
  {
    "id": "fn.byrow.iife-lambda-not-parsed",
    "description": "Immediately-invoked LAMBDA(...)(args) is not parsed",
    "tags": ["byrow", "lambda"],
    "formula": "=BYROW({1,2},LAMBDA(x,SUM(x))({1,2}))",
    "expected": { "array": [[{ "number": 3 }]] },
    "ignore": "Immediately-invoked LAMBDA(...)(args) is not in the parser. BYROW requires an inline LAMBDA(row,body), a defined name that refers to one, or an eta aggregator name (SUM / AVERAGE / …)."
  }
