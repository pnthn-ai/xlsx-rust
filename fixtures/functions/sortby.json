    "tags": ["sortby", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SORTBY({3;1;2}, {30;10;20})",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    }
  },
