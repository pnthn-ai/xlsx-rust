  {
    "id": "fn.workday.ms-plain",
    "description": "Microsoft example: WORKDAY(1-Oct-08, 151) is 30-Apr-09",
    "tags": ["workday", "dates"],
    "formula": "=WORKDAY(DATE(2008,10,1),151)",
    "expected": { "number": 39933 }
  },
  {
    "id": "fn.workday.ms-holidays",
    "description": "Microsoft example: 151 workdays skipping three holidays is 5-May-09",
    "tags": ["workday", "dates"],
    "formula": "=WORKDAY(A1,A2,B1:B3)",
    "expected": { "number": 39938 },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
            "A1": { "number": 39722 },
