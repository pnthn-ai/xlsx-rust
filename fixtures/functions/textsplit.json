  {
    "id": "fn.textsplit.array-of-arrays-not-modeled",
    "description": "TEXTSPLIT of a column of strings is not Excel's array-of-arrays spill",
    "ignore": "Excel TEXTSPLIT on a range returns an array of arrays (often truncated or an error). This engine scalarizes text to one string. Documented model limit, not a hidden bug.",
    "tags": ["textsplit", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(A1:A2, \",\")",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a,b" },
          "A2": { "text": "c,d" }
        }
      }]
    },
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }]]
    }
  },
  {
    "id": "fn.textsplit.spill-occupancy-not-modeled",
    "description": "Blocked spill destination is not #SPILL! in this model",
    "ignore": "Workbook snippets have no spill grid. TEXTSPLIT returns an array value; #SPILL! from occupied cells below/right of the host is not modeled.",
    "tags": ["textsplit", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b\", \",\")",
    "at": "Sheet1!A1",
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": { "B1": { "text": "blocker" } }
      }]
    },
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }]]
    }
  }
