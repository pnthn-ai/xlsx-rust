      "array": [[{ "text": "axb" }, { "text": "c" }]]
    }
  },
  {
    "id": "fn.textsplit.match-mode-insensitive",
    "description": "match_mode 1 splits on X and x",
    "tags": ["textsplit", "case"],
    "quirks": ["array-eval-mode", "case-insensitive-text"],
    "formula": "=TEXTSPLIT(\"axbXc\", \"X\", , , 1)",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }, { "text": "c" }]]
    }
  },
  {
    "id": "fn.textsplit.match-mode-true",
    "description": "TRUE coerces to match_mode 1",
    "tags": ["textsplit", "case"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"axbXc\", \"X\", , , TRUE)",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }, { "text": "c" }]]
    }
  },
  {
