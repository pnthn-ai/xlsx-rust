      "array": [[{ "text": "" }, { "text": "a" }, { "text": "" }]]
    }
  },
  {
    "id": "fn.textsplit.leading-trailing-ignore",
    "description": "ignore_empty TRUE drops leading/trailing empties",
    "tags": ["textsplit", "empty"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\",a,\", \",\", , TRUE)",
    "expected": {
      "array": [[{ "text": "a" }]]
    }
  },
  {
    "id": "fn.textsplit.space-not-empty",
    "description": "A space token is kept when ignore_empty is TRUE",
    "tags": ["textsplit", "empty"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a, ,b\", \",\", , TRUE)",
