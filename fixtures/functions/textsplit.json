[
  {
    "id": "fn.textsplit.cols-basic",
    "description": "TEXTSPLIT with a column delimiter spills one row",
    "tags": ["textsplit", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b,c\", \",\")",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }, { "text": "c" }]]
    }
  },
  {
    "id": "fn.textsplit.ms-red-blue-green",
    "description": "Microsoft / Exceljet example: hyphen into columns",
    "tags": ["textsplit", "functions"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"red-blue-green\", \"-\")",
    "expected": {
      "array": [[{ "text": "red" }, { "text": "blue" }, { "text": "green" }]]
    }
  },
  {
    "id": "fn.textsplit.rows-omitted-col",
    "description": "Omitted col_delimiter + row_delimiter spills a column",
    "tags": ["textsplit", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"red-blue-green\",, \"-\")",
    "expected": {
      "array": [
        [{ "text": "red" }],
        [{ "text": "blue" }],
        [{ "text": "green" }]
      ]
    }
  },
  {
    "id": "fn.textsplit.2d-even",
    "description": "Both delimiters with equal-width rows need no pad",
    "tags": ["textsplit", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b;c,d\", \",\", \";\")",
    "expected": {
      "array": [
        [{ "text": "a" }, { "text": "b" }],
        [{ "text": "c" }, { "text": "d" }]
      ]
    }
  },
  {
    "id": "fn.textsplit.2d-pad-na",
    "description": "Uneven 2-D rows pad with #N/A by default",
    "tags": ["textsplit", "functions", "pad"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b;c\", \",\", \";\")",
    "expected": {
      "array": [
        [{ "text": "a" }, { "text": "b" }],
        [{ "text": "c" }, { "error": "#N/A" }]
      ]
    },
    "notes": "pad_with omitted defaults to #N/A so the result stays rectangular."
  },
  {
    "id": "fn.textsplit.2d-pad-with-empty",
    "description": "pad_with \"\" replaces #N/A on short rows",
    "tags": ["textsplit", "functions", "pad"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b;c\", \",\", \";\", FALSE, 0, \"\")",
    "expected": {
      "array": [
        [{ "text": "a" }, { "text": "b" }],
        [{ "text": "c" }, { "text": "" }]
      ]
    }
  },
  {
    "id": "fn.textsplit.2d-pad-with-x",
    "description": "pad_with text fills the missing 2-D cell",
    "tags": ["textsplit", "pad"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,b;c\", \",\", \";\", FALSE, 0, \"x\")",
    "expected": {
      "array": [
        [{ "text": "a" }, { "text": "b" }],
        [{ "text": "c" }, { "text": "x" }]
      ]
    }
  },
  {
    "id": "fn.textsplit.ignore-empty-false",
