    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,,b\", \",\", , TRUE)",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }]]
    }
  },
  {
    "id": "fn.textsplit.ignore-empty-one",
    "description": "Numeric 1 is TRUE for ignore_empty",
    "tags": ["textsplit", "empty"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(\"a,,b\", \",\", , 1)",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }]]
    }
  },
  {
