  {
    "id": "fn.textsplit.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL!",
    "notes": "Excel would #SPILL! if TEXTSPLIT at B1 needed B2. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX.",
    "tags": ["textsplit", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTSPLIT(A1, \",\")",
    "at": "Sheet1!B1",
    "expected": {
      "array": [[{ "text": "a" }, { "text": "b" }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a,b" },
          "C1": { "text": "blocker" }
        }
      }]
    }
  },
  {
