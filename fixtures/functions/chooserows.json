  {
    "id": "fn.chooserows.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — CHOOSEROWS returns the array",
    "notes": "Excel would #SPILL! if CHOOSEROWS at B1 needed B2. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["chooserows", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS(A1:A3, 1, 3)",
    "at": "Sheet1!B1",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 3 }]] },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
