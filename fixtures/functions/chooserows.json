[
  {
    "id": "fn.chooserows.col-basic",
    "description": "CHOOSEROWS of a column returns the listed row as a 1×1 array",
    "tags": ["chooserows", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 2)",
    "expected": { "array": [[{ "number": 2 }]] }
  },
  {
    "id": "fn.chooserows.col-multi",
    "description": "Several row_num arguments keep listed order",
    "tags": ["chooserows", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 1, 3)",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 3 }]] }
  },
  {
    "id": "fn.chooserows.reorder",
    "description": "Rows can be returned in any order",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 3, 1, 2)",
    "expected": { "array": [[{ "number": 3 }], [{ "number": 1 }], [{ "number": 2 }]] }
  },
  {
    "id": "fn.chooserows.repeat",
    "description": "Duplicate row_num values are kept (row 1 twice)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 1, 1)",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 1 }]] }
  },
  {
    "id": "fn.chooserows.matrix",
    "description": "2-D CHOOSEROWS keeps every column of the picked rows",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1,2;3,4;5,6}, 1, 3)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 5 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.chooserows.row-vector",
    "description": "A single-row array has only row 1 (and -1)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1,2,3}, 1)",
    "expected": { "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }]] }
  },
  {
    "id": "fn.chooserows.neg-last",
    "description": "Negative index -1 is the last row (not INDEX #REF!)",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, -1)",
    "expected": { "array": [[{ "number": 3 }]] },
    "notes": "CHOOSEROWS(-1) counts from the bottom. INDEX(..., -1) is #REF! in this engine."
  },
  {
    "id": "fn.chooserows.neg-two",
    "description": "CHOOSEROWS(..., -1, -2) is last then second-to-last",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3;4}, -1, -2)",
    "expected": { "array": [[{ "number": 4 }], [{ "number": 3 }]] }
  },
  {
    "id": "fn.chooserows.neg-last-two-in-order",
    "description": "Last two rows in natural order: -2, -1",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3;4}, -2, -1)",
    "expected": { "array": [[{ "number": 3 }], [{ "number": 4 }]] }
  },
  {
    "id": "fn.chooserows.neg-reverse",
    "description": "Explicit negatives reverse a column (SEQUENCE is not required)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, -1, -2, -3)",
    "expected": { "array": [[{ "number": 3 }], [{ "number": 2 }], [{ "number": 1 }]] }
  },
  {
    "id": "fn.chooserows.mix-pos-neg",
    "description": "First and last row via 1 and -1",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 1, -1)",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 3 }]] }
  },
  {
    "id": "fn.chooserows.zero-value",
    "description": "row_num 0 is #VALUE! (Microsoft: abs zero)",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2}, 0)",
    "expected": { "error": "#VALUE!" },
    "notes": "Not #REF!. INDEX(..., 0) is #REF! in this engine; CHOOSEROWS(0) is #VALUE!."
  },
  {
    "id": "fn.chooserows.pos-oob-value",
    "description": "Positive row_num past the height is #VALUE!, not INDEX #REF!",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2}, 3)",
    "expected": { "error": "#VALUE!" },
    "notes": "INDEX({1;2;3}, 4) is #REF! (fixtures/functions/lookup.json). CHOOSEROWS out-of-range is #VALUE!."
  },
  {
    "id": "fn.chooserows.neg-oob-value",
    "description": "Negative abs exceeding height is #VALUE!",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2}, -3)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.chooserows.false-is-zero",
    "description": "FALSE coerces to 0 → #VALUE!",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode", "bool-number-equality"],
    "formula": "=CHOOSEROWS({1;2}, FALSE)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.chooserows.true-is-one",
    "description": "TRUE coerces to 1 (first row)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode", "bool-number-equality"],
    "formula": "=CHOOSEROWS({1;2;3}, TRUE)",
    "expected": { "array": [[{ "number": 1 }]] }
  },
  {
    "id": "fn.chooserows.blank-row-num",
    "description": "Blank row_num coerces to 0 → #VALUE!",
    "tags": ["chooserows", "errors", "empty"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=CHOOSEROWS({1;2}, A1)",
