  },
  {
    "id": "fn.chooserows.sequence-reverse-not-modeled",
    "description": "CHOOSEROWS(a, SEQUENCE(...)) needs SEQUENCE; reverse with explicit negatives instead",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, SEQUENCE(3,1,3,-1))",
    "expected": { "array": [[{ "number": 3 }], [{ "number": 2 }], [{ "number": 1 }]] },
    "ignore": "SEQUENCE is not implemented. Reverse with CHOOSEROWS({1;2;3}, -1, -2, -3). This ignore documents a model limit, not a broken CHOOSEROWS."
  }
