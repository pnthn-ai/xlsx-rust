    "workbook": { "sheets": [{ "name": "Sheet1", "cells": {} }] }
  },
  {
    "id": "fn.chooserows.text-row-num",
    "description": "Non-numeric text row_num is #VALUE!",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2}, \"x\")",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.chooserows.text-number",
    "description": "Numeric text row_num coerces (\"2\" → row 2)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode", "equality-vs-arithmetic-coercion"],
    "formula": "=CHOOSEROWS({1;2;3}, \"2\")",
    "expected": { "array": [[{ "number": 2 }]] }
  },
  {
    "id": "fn.chooserows.arity-one",
    "description": "CHOOSEROWS(array) without a row_num is #VALUE!",
    "tags": ["chooserows", "errors"],
    "formula": "=CHOOSEROWS({1;2})",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.chooserows.arity-zero",
    "description": "CHOOSEROWS() is #VALUE!",
    "tags": ["chooserows", "errors"],
    "formula": "=CHOOSEROWS()",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.chooserows.trunc-pos",
    "description": "Positive fractional row_num truncates toward zero (1.9 → 1)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, 1.9)",
    "expected": { "array": [[{ "number": 1 }]] },
    "notes": "Modeled as TRUNC (toward zero), same as CHOOSE/INDEX in this engine. Live Excel is not in CI."
  },
  {
    "id": "fn.chooserows.trunc-neg",
    "description": "Negative fractional row_num truncates toward zero (-1.9 → -1, last row)",
    "tags": ["chooserows"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2;3}, -1.9)",
    "expected": { "array": [[{ "number": 3 }]] },
    "notes": "Toward-zero TRUNC, not INT/floor: -1.9 → -1, not -2. Documented model; live Excel not in CI."
  },
  {
    "id": "fn.chooserows.frac-under-one-value",
    "description": "0.9 truncates to 0 → #VALUE!",
    "tags": ["chooserows", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSEROWS({1;2}, 0.9)",
    "expected": { "error": "#VALUE!" }
  },
