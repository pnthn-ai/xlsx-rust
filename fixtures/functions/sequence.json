    "tags": ["sequence", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SEQUENCE(4)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }],
        [{ "number": 4 }]
      ]
    }
  },
