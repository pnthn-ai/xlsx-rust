  {
    "id": "fn.sequence.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — SEQUENCE returns the array",
    "notes": "Excel would #SPILL! if SEQUENCE(3) at B1 needed B2:B3. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["sequence", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=SEQUENCE(3)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [[{ "number": 1 }], [{ "number": 2 }], [{ "number": 3 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "B2": { "number": 99 },
          "B3": { "text": "blocked" }
        }
      }]
    }
  },
  {
    "id": "fn.sequence.oversize-rows",
    "description": "rows above the 2^24 cell safety cap is #VALUE! without allocating",
    "notes": "Model limit: SEQUENCE_MAX_CELLS = 16,777,216. Excel would #SPILL! at the sheet edge; this engine has no spill grid.",
    "tags": ["sequence", "errors", "limits"],
    "formula": "=SEQUENCE(16777217)",
    "expected": { "error": "#VALUE!" }
  },
