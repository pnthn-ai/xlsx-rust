    "id": "fn.sequence.dynamic-array-mode",
    "description": "array_mode=dynamic-array still returns the SEQUENCE array (no grid write)",
    "tags": ["sequence", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=SEQUENCE(A1)",
    "options": { "array_mode": "dynamic-array" },
    "expected": {
      "array": [[{ "number": 1 }], [{ "number": 2 }], [{ "number": 3 }]]
    },
