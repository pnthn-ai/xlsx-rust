[
  {
    "id": "fn.textjoin-ms-sun",
    "description": "Microsoft example: TEXTJOIN(\" \", TRUE, words) joins with spaces",
    "tags": ["textjoin", "text"],
    "formula": "=TEXTJOIN(\" \", TRUE, \"The\", \"sun\", \"will\", \"come\", \"up\", \"tomorrow.\")",
    "expected": { "text": "The sun will come up tomorrow." }
  },
  {
    "id": "fn.textjoin-ignore-true-empty-literal",
    "description": "ignore_empty TRUE skips stored empty strings",
    "tags": ["textjoin", "text", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=TEXTJOIN(\",\", TRUE, \"a\", \"\", \"b\")",
    "expected": { "text": "a,b" }
  },
  {
    "id": "fn.textjoin-ignore-false-empty-literal",
    "description": "ignore_empty FALSE keeps empty strings (consecutive delimiters)",
    "tags": ["textjoin", "text", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=TEXTJOIN(\",\", FALSE, \"a\", \"\", \"b\")",
    "expected": { "text": "a,,b" }
  },
  {
    "id": "fn.textjoin-ignore-false-two-empties",
    "description": "Two empties with ignore_empty FALSE produce one delimiter",
    "tags": ["textjoin", "text", "empty"],
    "formula": "=TEXTJOIN(\",\", FALSE, \"\", \"\")",
    "expected": { "text": "," }
  },
  {
    "id": "fn.textjoin-ignore-true-two-empties",
    "description": "All-empty with ignore_empty TRUE is empty text",
    "tags": ["textjoin", "text", "empty"],
    "formula": "=TEXTJOIN(\",\", TRUE, \"\", \"\")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.textjoin-single-empty-false",
    "description": "A single empty piece emits no delimiter",
    "tags": ["textjoin", "text", "empty"],
    "formula": "=TEXTJOIN(\",\", FALSE, \"\")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.textjoin-triple-empty-false",
    "description": "Three empties with FALSE yield two delimiters",
    "tags": ["textjoin", "text", "empty"],
    "formula": "=TEXTJOIN(\",\", FALSE, \"\", \"\", \"\")",
    "expected": { "text": ",," }
  },
  {
    "id": "fn.textjoin-space-not-empty",
    "description": "A space is not empty and is kept when ignore_empty is TRUE",
    "tags": ["textjoin", "text", "empty"],
    "formula": "=TEXTJOIN(\",\", TRUE, \"a\", \" \", \"b\")",
    "expected": { "text": "a, ,b" }
  },
  {
    "id": "fn.textjoin-blank-range-true",
    "description": "ignore_empty TRUE skips blank cells in a range",
    "tags": ["textjoin", "text", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=TEXTJOIN(\",\", TRUE, A1:A3)",
    "expected": { "text": "a,b" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a" },
          "A3": { "text": "b" }
        }
      }]
    }
  },
  {
    "id": "fn.textjoin-blank-range-false",
    "description": "ignore_empty FALSE keeps blank cells as empty pieces",
    "tags": ["textjoin", "text", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=TEXTJOIN(\",\", FALSE, A1:A3)",
    "expected": { "text": "a,,b" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "text": "a" },
          "A3": { "text": "b" }
        }
      }]
    }
  },
  {
    "id": "fn.textjoin-stored-empty-vs-blank-true",
