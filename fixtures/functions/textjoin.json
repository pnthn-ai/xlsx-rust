    "tags": [
      "textjoin",
      "text",
      "empty"
    ],
    "quirks": [
      "empty-cell-duality"
    ],
    "formula": "=TEXTJOIN(\",\", FALSE, \"a\", \"\", \"b\")",
    "expected": {
      "text": "a,,b"
    }
  },
  {
