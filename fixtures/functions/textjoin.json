[
  {
    "id": "fn.textjoin-ms-sun",
    "description": "Microsoft example: TEXTJOIN(\" \", TRUE, words) joins with spaces",
    "tags": [
      "textjoin",
      "text"
    ],
    "formula": "=TEXTJOIN(\" \", TRUE, \"The\", \"sun\", \"will\", \"come\", \"up\", \"tomorrow.\")",
    "expected": {
      "text": "The sun will come up tomorrow."
    }
  },
  {
    "id": "fn.textjoin-ignore-true-empty-literal",
    "description": "ignore_empty TRUE skips stored empty strings",
    "tags": [
      "textjoin",
      "text",
      "empty"
    ],
    "quirks": [
      "empty-cell-duality"
    ],
    "formula": "=TEXTJOIN(\",\", TRUE, \"a\", \"\", \"b\")",
    "expected": {
      "text": "a,b"
    }
  },
  {
    "id": "fn.textjoin-ignore-false-empty-literal",
