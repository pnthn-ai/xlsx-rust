    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TEXTJOIN({\"-\",\"|\"}, FALSE, \"a\", \"\", \"b\", \"c\")",
    "expected": { "text": "a-|b-c" }
  },
