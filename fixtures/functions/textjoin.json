    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TEXTJOIN({\"-\",\"|\"}, TRUE, \"a\", \"\", \"b\", \"c\")",
    "expected": { "text": "a-b|c" }
  },
  {
    "id": "fn.textjoin-cycle-keep-empty",
    "description": "With ignore_empty FALSE, empties consume a delimiter slot",
