  {
    "id": "fn.textjoin-cycle-array",
    "description": "Array delimiter cycles between emitted pieces",
    "tags": ["textjoin", "text", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TEXTJOIN({\",\",\";\"}, TRUE, \"a\", \"b\", \"c\", \"d\")",
