[
  {
    "id": "fn.randarray.constant-2x3-int",
    "description": "RANDARRAY(2,3,7,7,TRUE) is a 2×3 array of 7 — min=max is a justified constant, not an invented RNG golden",
    "tags": ["randarray", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=RANDARRAY(2, 3, 7, 7, TRUE)",
    "expected": {
      "array": [
        [{ "number": 7 }, { "number": 7 }, { "number": 7 }],
        [{ "number": 7 }, { "number": 7 }, { "number": 7 }]
      ]
    }
  },
  {
    "id": "fn.randarray.constant-decimal",
