[
  {
    "id": "fn.averageif.gt-same-range",
    "description": "Two-arg AVERAGEIF averages values in range that are > 2",
    "tags": ["averageif", "functions"],
    "formula": "=AVERAGEIF(A1:A3, \">2\")",
    "expected": { "number": 4.5 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 6 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.averageif.gt-average-range",
    "description": "Three-arg AVERAGEIF applies criteria to range and averages average_range",
    "tags": ["averageif", "functions"],
    "formula": "=AVERAGEIF(A1:A3, \">2\", B1:B3)",
    "expected": { "number": 25 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 6 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 }
        }
      }]
    }
  },
  {
    "id": "fn.averageif.no-matches-div0",
    "description": "No matches is #DIV/0!, not 0 (unlike SUMIF)",
    "tags": ["averageif", "errors"],
    "formula": "=AVERAGEIF(A1:A3, \">100\")",
    "expected": { "error": "#DIV/0!" },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 }
        }
      }]
    }
  },
  {
    "id": "fn.averageif.empty-range-div0",
    "description": "A blank range is #DIV/0!",
    "tags": ["averageif", "empty", "errors"],
    "quirks": ["empty-cell-duality"],
    "formula": "=AVERAGEIF(A1:A3, \">0\")",
    "expected": { "error": "#DIV/0!" },
    "workbook": { "sheets": [{ "name": "Sheet1", "cells": {} }] }
  },
  {
    "id": "fn.averageif.matches-but-avg-blank-div0",
