[
  {
    "id": "fn.concat-ms-sun",
    "description": "Microsoft example: CONCAT joins words and spaces into a sentence",
    "tags": [
      "concat",
      "text"
    ],
    "formula": "=CONCAT(\"The\",\" \",\"sun\",\" \",\"will\",\" \",\"come\",\" \",\"up\",\" \",\"tomorrow.\")",
    "expected": {
      "text": "The sun will come up tomorrow."
    }
  },
