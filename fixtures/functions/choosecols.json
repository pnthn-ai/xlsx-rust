  {
    "id": "fn.choosecols.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — CHOOSECOLS returns the array",
    "notes": "Excel would #SPILL! if CHOOSECOLS at B1 needed B2. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM.",
    "tags": ["choosecols", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2;3,4}, 1)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [[{ "number": 1 }], [{ "number": 3 }]]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
    "id": "fn.choosecols.scalar-plus-top-left",
    "description": "CHOOSECOLS(...)+1 scalarizes to the top-left (no host-aware spill intersect)",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "notes": "The engine has no written spill. Scalar operators take the top-left element.",
    "formula": "=CHOOSECOLS({10,20;30,40}, 2)+1",
    "expected": { "number": 21 }
  }
