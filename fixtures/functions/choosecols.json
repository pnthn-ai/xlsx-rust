      ]
    }
  },
  {
    "id": "fn.choosecols.neg-last",
    "description": "Negative index: -1 is the last column",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "notes": "Excel counts from the right. -1 is last, not a wrap of column 1.",
    "formula": "=CHOOSECOLS({1,2,3}, -1)",
    "expected": { "array": [[{ "number": 3 }]] }
  },
  {
    "id": "fn.choosecols.neg-second-last",
    "description": "Negative index: -2 is the second-last column",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3}, -2)",
    "expected": { "array": [[{ "number": 2 }]] }
  },
  {
    "id": "fn.choosecols.neg-pair",
    "description": "Microsoft example: -1, -2 returns last then second-last",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,13,14;3,4,15,16}, -1, -2)",
    "expected": {
      "array": [
        [{ "number": 14 }, { "number": 13 }],
        [{ "number": 16 }, { "number": 15 }]
      ]
    }
  },
  {
    "id": "fn.choosecols.mix-pos-neg",
    "description": "First and last columns via 1, -1",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3;4,5,6}, 1, -1)",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 3 }],
        [{ "number": 4 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.choosecols.zero",
    "description": "col_num 0 is #VALUE! (not a valid index)",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "notes": "Microsoft: #VALUE! if the absolute value of any col_num is zero or exceeds the column count.",
    "formula": "=CHOOSECOLS({1,2,3}, 0)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.zero-among",
    "description": "A zero among valid col_nums is still #VALUE!",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3}, 1, 0)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.oob-pos",
    "description": "Positive col_num past the width is #VALUE!, not INDEX #REF!",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "notes": "INDEX({1,2,3}, 4) is #REF!. CHOOSECOLS({1,2,3}, 4) is #VALUE!.",
    "formula": "=CHOOSECOLS({1,2,3}, 4)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.oob-neg",
    "description": "Negative col_num whose abs exceeds width is #VALUE!",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "notes": "On a 3-column array, -3 is column 1; -4 is #VALUE!. No wrap-around.",
    "formula": "=CHOOSECOLS({1,2,3}, -4)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.neg-width",
    "description": "Exactly -ncols is the first column",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3}, -3)",
    "expected": { "array": [[{ "number": 1 }]] }
  },
  {
    "id": "fn.choosecols.vs-index-oob",
    "description": "INDEX of the same OOB position is #REF! (contrast)",
    "tags": ["choosecols", "index", "errors"],
    "formula": "=INDEX({1,2,3}, 4)",
    "expected": { "error": "#REF!" }
  },
  {
    "id": "fn.choosecols.arity-none",
    "description": "CHOOSECOLS() is #VALUE!",
    "tags": ["choosecols", "errors"],
    "formula": "=CHOOSECOLS()",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.arity-one",
    "description": "Missing col_num1 is #VALUE!",
    "tags": ["choosecols", "errors"],
    "formula": "=CHOOSECOLS({1,2,3})",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.trunc-pos",
    "description": "Fractional col_num truncates toward zero (CHOOSE family)",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "notes": "1.9 → 1, same as CHOOSE(1.9, …). No live Excel recording in CI; this is the documented CHOOSE/INDEX truncation rule, not a guessed golden.",
    "formula": "=CHOOSECOLS({1,2,3}, 1.9)",
    "expected": { "array": [[{ "number": 1 }]] }
  },
  {
    "id": "fn.choosecols.trunc-neg",
    "description": "-1.9 truncates toward zero to -1 (last column)",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "notes": "Toward-zero, not toward -∞. -1.9 → -1, not -2.",
    "formula": "=CHOOSECOLS({1,2,3}, -1.9)",
    "expected": { "array": [[{ "number": 3 }]] }
  },
  {
    "id": "fn.choosecols.trunc-to-zero",
    "description": "0.9 truncates to 0 and is #VALUE!",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3}, 0.9)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.trunc-neg-to-zero",
    "description": "-0.4 truncates to 0 and is #VALUE!",
    "tags": ["choosecols", "errors"],
    "quirks": ["array-eval-mode"],
    "formula": "=CHOOSECOLS({1,2,3}, -0.4)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.choosecols.trunc-last-ok",
    "description": "3.9 on a 3-column array truncates to 3 (still in range)",
    "tags": ["choosecols"],
    "quirks": ["array-eval-mode"],
    "notes": "Truncate first, then apply abs-exceeds. 3.9 → 3, not #VALUE! from abs(3.9)>3.",
    "formula": "=CHOOSECOLS({1,2,3}, 3.9)",
    "expected": { "array": [[{ "number": 3 }]] }
  },
  {
