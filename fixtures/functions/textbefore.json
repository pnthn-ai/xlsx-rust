[
  {
    "id": "fn.textbefore-ms-hood",
    "description": "TEXTBEFORE(\"Red riding hood's, red hood\", \"hood\") is \"Red riding \" (Microsoft example; trailing space before the delimiter)",
    "tags": ["text", "textbefore"],
    "formula": "=TEXTBEFORE(\"Red riding hood's, red hood\", \"hood\")",
    "expected": { "text": "Red riding " }
  },
  {
