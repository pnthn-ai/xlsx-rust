  {
    "id": "fn.makearray.mul-3x3",
    "description": "MAKEARRAY 3×3 multiplication table via LAMBDA(r,c,r*c)",
    "tags": ["makearray", "lambda", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=MAKEARRAY(3,3,LAMBDA(r,c,r*c))",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }, { "number": 3 }],
        [{ "number": 2 }, { "number": 4 }, { "number": 6 }],
        [{ "number": 3 }, { "number": 6 }, { "number": 9 }]
      ]
    }
  },
