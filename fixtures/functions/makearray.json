  {
    "id": "fn.lambda.bare-is-calc",
    "description": "Bare LAMBDA has no first-class function value here; #CALC!",
    "tags": ["lambda", "errors"],
    "formula": "=LAMBDA(x,x+1)",
    "expected": { "error": "#CALC!" },
    "notes": "Excel 365 can store a LAMBDA as a cell function value. This engine only applies LAMBDA when MAKEARRAY / MAP (or a defined name consumed by those) binds it."
  },
  {
    "id": "fn.makearray.spill-occupancy-not-modeled",
    "description": "#SPILL! from a blocked spill range is not produced",
    "tags": ["makearray"],
    "quirks": ["array-eval-mode"],
    "formula": "=MAKEARRAY(2,1,LAMBDA(r,c,r))",
    "expected": { "array": [[{ "number": 1 }], [{ "number": 2 }]] },
    "ignore": "Workbook snippets have no spill grid. MAKEARRAY returns an array value; #SPILL! from occupied cells below/right of the host is not modeled."
  },
  {
    "id": "fn.makearray.iife-lambda-not-parsed",
    "description": "Immediately-invoked LAMBDA(...)(args) is not parsed",
    "tags": ["makearray", "lambda"],
    "formula": "=MAKEARRAY(1,1,LAMBDA(x,y,x)(1,1))",
    "expected": { "array": [[{ "number": 1 }]] },
    "ignore": "Immediately-invoked LAMBDA(...)(args) is not in the parser. MAKEARRAY requires an inline LAMBDA(r,c,body) or a defined name that refers to one."
