    "quirks": ["array-eval-mode"],
    "formula": "=VSTACK({1,2}, {3,4}, {5,6})",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }],
        [{ "number": 5 }, { "number": 6 }]
      ]
    }
  },
  {
    "id": "fn.vstack.scalar-column",
