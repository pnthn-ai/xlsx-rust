[
  {
    "id": "fn.vstack.two-cols",
    "description": "VSTACK of two columns appends rows",
    "tags": ["vstack", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=VSTACK({1;2}, {3;4})",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }],
        [{ "number": 4 }]
      ]
    }
  },
  {
    "id": "fn.vstack.two-rows",
    "description": "VSTACK of two equal-width rows",
    "tags": ["vstack", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=VSTACK({1,2}, {3,4})",
    "expected": {
      "array": [
        [{ "number": 1 }, { "number": 2 }],
        [{ "number": 3 }, { "number": 4 }]
      ]
    }
  },
  {
    "id": "fn.vstack.three-blocks",
