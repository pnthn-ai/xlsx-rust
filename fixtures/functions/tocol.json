  {
    "id": "fn.tocol.no-grid-write",
    "description": "Occupied cells in the Excel spill zone do not produce #SPILL! — TOCOL returns the array",
    "notes": "Excel would #SPILL! if TOCOL at B1 needed B2:B4. This model never writes a spill range; neighbors are irrelevant. Pick individual results with INDEX/SUM. Excel's 1,048,576-row result cap is enforced as #NUM! in the kernel (unit-tested); it is not exercised here.",
    "tags": ["tocol", "spill"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOCOL(A1:A3)",
    "at": "Sheet1!B1",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 2 },
          "A3": { "number": 3 },
          "B2": { "text": "blocker" }
        }
      }]
    }
  },
  {
    "id": "fn.tocol.scalar-plus-top-left",
    "description": "TOCOL+n in a scalar operator takes the top-left value (not host-aware spill intersection)",
    "notes": "The engine scalarizes arrays to the first element. It does not intersect a written spill with the host cell.",
    "tags": ["tocol", "arithmetic"],
    "quirks": ["array-eval-mode", "implicit-intersection"],
    "formula": "=TOCOL({10,20;30,40})+1",
    "expected": { "number": 11 }
  },
  {
    "id": "fn.tocol.false-defaults",
    "description": "Explicit 0,FALSE matches omitted optional args",
    "tags": ["tocol", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOCOL({1,2;3,4}, 0, FALSE)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }],
        [{ "number": 4 }]
      ]
    }
  },
  {
    "id": "fn.tocol.bools-and-zeros",
    "description": "FALSE and 0 are kept as their own types; neither is a blank",
    "tags": ["tocol", "functions", "array"],
    "quirks": ["array-eval-mode", "empty-cell-duality"],
    "formula": "=TOCOL({0,FALSE;\"\",1}, 1)",
    "expected": {
      "array": [
        [{ "number": 0 }],
        [{ "bool": false }],
        [{ "text": "" }],
        [{ "number": 1 }]
      ]
    }
  }
