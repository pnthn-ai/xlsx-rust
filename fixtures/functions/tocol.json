  {
    "id": "fn.tocol.range",
    "description": "TOCOL of a worksheet 2×2 is row-major",
    "tags": ["tocol", "functions"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOCOL(A1:B2)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }],
        [{ "number": 4 }]
      ]
    },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 2 },
          "A2": { "number": 3 }, "B2": { "number": 4 }
        }
      }]
    }
  },
