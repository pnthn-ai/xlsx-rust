[
  {
    "id": "fn.tocol.row-major-literal",
    "description": "TOCOL of a 2×2 literal is row-major by default",
    "tags": ["tocol", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOCOL({1,2;3,4})",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 2 }],
        [{ "number": 3 }],
        [{ "number": 4 }]
      ]
    }
  },
  {
    "id": "fn.tocol.scan-by-col",
    "description": "scan_by_col=TRUE walks top-to-bottom then right",
    "tags": ["tocol", "functions", "array"],
    "quirks": ["array-eval-mode"],
    "formula": "=TOCOL({1,2;3,4}, 0, TRUE)",
    "expected": {
      "array": [
        [{ "number": 1 }],
        [{ "number": 3 }],
        [{ "number": 2 }],
        [{ "number": 4 }]
      ]
    }
  },
