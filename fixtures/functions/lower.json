  {
    "id": "fn.lower-implicit-intersect",
    "description": "LOWER(A1:A3) from host B1 uses implicit intersection (same row → A1)",
    "tags": ["text", "lower"],
    "quirks": ["implicit-intersection"],
    "at": "Sheet1!B1",
    "formula": "=LOWER(A1:A3)",
    "expected": { "text": "one" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
