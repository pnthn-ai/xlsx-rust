[
  {
    "id": "fn.lower-microsoft-cummings",
    "description": "Microsoft example: LOWER(\"E. E. Cummings\")",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"E. E. Cummings\")",
    "expected": { "text": "e. e. cummings" }
  },
  {
    "id": "fn.lower-microsoft-apt",
    "description": "Microsoft example: LOWER(\"Apt. 2B\")",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"Apt. 2B\")",
    "expected": { "text": "apt. 2b" }
  },
  {
    "id": "fn.lower-empty",
    "description": "LOWER(\"\") is empty text",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"\")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.lower-already",
    "description": "Already-lowercase ASCII is unchanged (identity)",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"already lower\")",
    "expected": { "text": "already lower" }
  },
  {
    "id": "fn.lower-all-upper",
    "description": "All-ASCII-uppercase becomes lowercase",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"HELLO\")",
    "expected": { "text": "hello" }
  },
  {
    "id": "fn.lower-mixed",
    "description": "Mixed-case ASCII folds only the uppercase letters",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"AbC\")",
    "expected": { "text": "abc" }
  },
  {
    "id": "fn.lower-digits",
    "description": "Digits are not letters and stay",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"12345\")",
    "expected": { "text": "12345" }
  },
  {
    "id": "fn.lower-punct",
    "description": "Punctuation around the A/@ and Z/[ edges is unchanged",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"@A[`Z{\")",
    "expected": { "text": "@a[`z{" }
  },
  {
    "id": "fn.lower-spaces-kept",
    "description": "LOWER does not trim; leading/trailing/internal spaces stay",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"  Hello  World  \")",
    "expected": { "text": "  hello  world  " }
  },
  {
    "id": "fn.lower-alnum",
    "description": "Letters fold; digits and hyphens stay",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"ABC-123-XYZ\")",
    "expected": { "text": "abc-123-xyz" }
  },
  {
    "id": "fn.lower-nested",
    "description": "LOWER is idempotent: LOWER(LOWER(…)) matches LOWER",
    "tags": ["text", "lower"],
    "formula": "=LOWER(LOWER(\"AbC\"))",
    "expected": { "text": "abc" }
  },
  {
    "id": "fn.lower-of-upper",
    "description": "LOWER(UPPER(text)) is the lowercase form",
    "tags": ["text", "lower"],
    "formula": "=LOWER(UPPER(\"abc\"))",
    "expected": { "text": "abc" }
  },
  {
    "id": "fn.lower-len",
    "description": "LEN(LOWER(\"AbC\")) is 3",
    "tags": ["text", "lower"],
    "formula": "=LEN(LOWER(\"AbC\"))",
    "expected": { "number": 3 }
  },
  {
    "id": "fn.lower-exact",
    "description": "EXACT confirms the lowered text",
    "tags": ["text", "lower"],
    "formula": "=EXACT(LOWER(\"AbC\"), \"abc\")",
    "expected": { "bool": true }
  },
  {
    "id": "fn.lower-concat",
    "description": "LOWER of concatenated mixed-case pieces",
    "tags": ["text", "lower"],
    "formula": "=LOWER(\"Ab\"&\"C\")",
    "expected": { "text": "abc" }
  },
  {
    "id": "fn.lower-cell",
    "description": "LOWER of a stored mixed-case cell",
    "tags": ["text", "lower"],
    "formula": "=LOWER(A1)",
    "expected": { "text": "hello" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
            "A1": { "text": "HeLLo" }
          }
        }
      ]
    }
  },
  {
    "id": "fn.lower-blank-cell",
    "description": "Blank cell coerces like & to empty text",
    "tags": ["text", "lower", "empty"],
    "quirks": ["empty-cell-duality"],
    "formula": "=LOWER(A1)",
    "expected": { "text": "" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {}
        }
      ]
    }
  },
  {
    "id": "fn.lower-stored-empty",
    "description": "Stored \"\" is already empty after LOWER",
    "tags": ["text", "lower"],
    "formula": "=LOWER(A1)",
    "expected": { "text": "" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
            "A1": { "text": "" }
          }
        }
      ]
    }
  },
  {
    "id": "fn.lower-formula-cell",
    "description": "LOWER of a formula cell that yields mixed-case text",
    "tags": ["text", "lower"],
    "formula": "=LOWER(A1)",
    "expected": { "text": "abc" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
            "A1": { "formula": "=\"AbC\"" }
          }
        }
      ]
    }
  },
  {
    "id": "fn.lower-named",
    "description": "LOWER of a defined name referring to a cell",
    "tags": ["text", "lower", "named"],
    "formula": "=LOWER(Title)",
    "expected": { "text": "hello" },
    "workbook": {
      "sheets": [
        {
          "name": "Sheet1",
          "cells": {
            "A1": { "text": "HELLO" }
          }
        }
      ],
      "names": [{ "name": "Title", "refers_to": "Sheet1!A1" }]
    }
  },
  {
    "id": "fn.lower-number",
    "description": "LOWER(123) coerces to text \"123\"",
