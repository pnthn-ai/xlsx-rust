    "workbook": {
      "sheets": [{ "name": "Sheet1", "cells": {} }]
    }
  },
  {
    "id": "fn.substitute-wildcard-literal",
    "description": "* is a literal character, not a wildcard",
    "tags": ["text", "substitute"],
    "quirks": ["wildcards"],
    "formula": "=SUBSTITUTE(\"a*b*c\", \"*\", \"-\")",
    "expected": { "text": "a-b-c" }
  },
  {
    "id": "fn.substitute-unicode",
    "description": "UTF-8 grapheme-equivalent exact match (café)",
    "tags": ["text", "substitute"],
    "formula": "=SUBSTITUTE(\"café\", \"é\", \"e\")",
    "expected": { "text": "cafe" }
  },
  {
    "id": "fn.substitute-not-found",
    "description": "Missing old_text returns the original text",
