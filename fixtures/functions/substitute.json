    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.substitute-arity-5",
    "description": "Five arguments is #VALUE!",
    "tags": ["text", "substitute", "errors"],
    "formula": "=SUBSTITUTE(\"a\", \"a\", \"b\", 1, 1)",
