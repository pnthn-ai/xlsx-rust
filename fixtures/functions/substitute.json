    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.substitute-err-old",
    "description": "Error in old_text propagates",
    "tags": ["text", "substitute", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SUBSTITUTE(\"a\", 1/0, \"b\")",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.substitute-err-new",
    "description": "Error in new_text propagates",
    "tags": ["text", "substitute", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SUBSTITUTE(\"a\", \"a\", 1/0)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.substitute-err-instance",
    "description": "Error in instance_num propagates",
    "tags": ["text", "substitute", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SUBSTITUTE(\"a\", \"a\", \"b\", 1/0)",
    "expected": { "error": "#DIV/0!" }
  },
  {
    "id": "fn.substitute-err-left-wins",
    "description": "Left-to-right: text error beats a later #N/A",
    "tags": ["text", "substitute", "errors"],
    "quirks": ["error-precedence"],
    "formula": "=SUBSTITUTE(#DIV/0!, #N/A, \"b\")",
