    "formula": "=SUBSTITUTE(\"Quarter 1, 2011\", \"1\", \"2\", 3)",
    "expected": { "text": "Quarter 1, 2012" }
  },
  {
    "id": "fn.substitute-nth-past-end",
    "description": "instance_num past the last match leaves text unchanged",
    "tags": ["text", "substitute"],
    "formula": "=SUBSTITUTE(\"abc\", \"a\", \"x\", 2)",
    "expected": { "text": "abc" }
  },
  {
    "id": "fn.substitute-nth-zero",
