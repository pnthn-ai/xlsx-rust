  {
    "id": "countif.eq-number",
    "description": "COUNTIF matches a number and numeric text (unlike ordinary =)",
    "tags": ["countif", "functions"],
    "quirks": ["equality-vs-arithmetic-coercion"],
    "formula": "=COUNTIF(A1:A14, 5)",
    "expected": { "number": 2 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "number": 5 },
          "A3": { "number": 10 },
          "A4": { "text": "5" },
          "A5": { "text": "apple" },
          "A6": { "text": "Banana" },
          "A7": { "bool": true },
          "A8": { "bool": false },
          "A10": { "text": "" },
          "A11": { "text": "apricot" },
          "A12": { "error": "#N/A" },
          "A13": { "text": "TRUE" },
          "A14": { "number": 0 }
        }
      }]
    }
  },
