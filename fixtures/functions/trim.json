[
  {
    "id": "fn.trim-microsoft",
    "description": "Microsoft example: TRIM(\"  First Quarter Earnings  \")",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"  First Quarter Earnings  \")",
    "expected": { "text": "First Quarter Earnings" }
  },
  {
    "id": "fn.trim-empty",
    "description": "TRIM(\"\") is empty text",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"\")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.trim-spaces-only",
    "description": "A string of only ASCII spaces becomes empty",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"     \")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.trim-single-space",
    "description": "TRIM(\" \") is empty",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\" \")",
    "expected": { "text": "" }
  },
  {
    "id": "fn.trim-no-spaces",
    "description": "Text with no spaces is unchanged",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"hello\")",
    "expected": { "text": "hello" }
  },
  {
    "id": "fn.trim-already-clean",
    "description": "Already-trimmed single spaces stay (idempotent)",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"a b c\")",
    "expected": { "text": "a b c" }
  },
  {
    "id": "fn.trim-leading-only",
    "description": "Leading ASCII spaces are stripped",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"   hello\")",
    "expected": { "text": "hello" }
  },
  {
    "id": "fn.trim-trailing-only",
    "description": "Trailing ASCII spaces are stripped",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"hello   \")",
    "expected": { "text": "hello" }
  },
  {
    "id": "fn.trim-many-internal",
    "description": "Internal ASCII space runs collapse to one space",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"a    b     c\")",
    "expected": { "text": "a b c" }
  },
  {
    "id": "fn.trim-nested",
    "description": "TRIM is idempotent: TRIM(TRIM(…)) matches TRIM",
    "tags": ["text", "trim"],
    "formula": "=TRIM(TRIM(\"  a  b  \"))",
    "expected": { "text": "a b" }
  },
  {
    "id": "fn.trim-len",
    "description": "LEN(TRIM(\"  a  b  \")) is 3",
    "tags": ["text", "trim"],
    "formula": "=LEN(TRIM(\"  a  b  \"))",
    "expected": { "number": 3 }
  },
  {
    "id": "fn.trim-exact",
    "description": "EXACT confirms TRIM result is a single internal space",
    "tags": ["text", "trim"],
    "formula": "=EXACT(TRIM(\"  a  b  \"), \"a b\")",
    "expected": { "bool": true }
  },
  {
    "id": "fn.trim-concat",
    "description": "TRIM of concatenated padded pieces",
    "tags": ["text", "trim"],
    "formula": "=TRIM(\"  \"&\"a\"&\"  \"&\"b\"&\"  \")",
    "expected": { "text": "a b" }
  },
  {
