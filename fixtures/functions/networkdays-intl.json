[
  {
    "id": "fn.networkdays-intl.ms-weekend7-holidays",
    "description": "Microsoft example: 1-Jan-06 to 1-Feb-06, weekend 7 (Fri/Sat), two Monday holidays is 22",
    "tags": ["networkdays-intl", "dates"],
    "formula": "=NETWORKDAYS.INTL(DATE(2006,1,1),DATE(2006,2,1),7,{DATE(2006,1,2),DATE(2006,1,16)})",
    "expected": { "number": 22 }
  },
  {
    "id": "fn.networkdays-intl.ms-span-default",
    "description": "Same Microsoft span with omitted weekend (Sat/Sun): 32 days minus 4 Sat minus 5 Sun = 23",
    "tags": ["networkdays-intl", "dates"],
    "formula": "=NETWORKDAYS.INTL(DATE(2006,1,1),DATE(2006,2,1))",
    "expected": { "number": 23 }
  },
  {
    "id": "fn.networkdays-intl.ms-span-code7",
