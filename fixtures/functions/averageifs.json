  {
    "id": "fn.averageifs.one-pair",
    "description": "Three-arg AVERAGEIFS is AVERAGEIF with reversed range order",
    "tags": ["averageifs", "functions"],
    "formula": "=AVERAGEIFS(B1:B3, A1:A3, \">2\")",
    "expected": { "number": 25 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 }, "B1": { "number": 10 },
          "A2": { "number": 6 }, "B2": { "number": 20 },
          "A3": { "number": 3 }, "B3": { "number": 30 }
        }
      }]
    }
  },
