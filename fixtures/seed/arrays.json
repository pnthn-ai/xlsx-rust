{
  "cases": [
    {
      "id": "array.literal-row",
      "description": "Horizontal array literal",
      "tags": ["array"],
      "quirks": ["array-eval-mode"],
      "formula": "={1,2,3}",
      "expected": {
        "array": [[{ "number": 1 }, { "number": 2 }, { "number": 3 }]]
      }
    },
    {
      "id": "array.literal-col",
      "description": "Vertical array literal",
      "tags": ["array"],
      "quirks": ["array-eval-mode"],
      "formula": "={1;2;3}",
      "expected": {
        "array": [[{ "number": 1 }], [{ "number": 2 }], [{ "number": 3 }]]
      }
    },
    {
      "id": "array.sum-of-literal",
      "description": "SUM of an array literal",
      "tags": ["array", "sum"],
      "formula": "=SUM({1,2,3})",
      "expected": { "number": 6 }
    }
  ]
}
