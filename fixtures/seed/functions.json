    "tags": ["functions", "if"],
    "formula": "=IF(TRUE, 10, 20)",
    "expected": { "number": 10 }
  },
  {
    "id": "fn.if-false",
    "description": "IF FALSE branch",
    "tags": ["functions", "if"],
    "formula": "=IF(FALSE, 10, 20)",
    "expected": { "number": 20 }
  },
  {
    "id": "fn.if-one",
    "description": "IF treats nonzero numbers as TRUE",
    "tags": ["functions", "if"],
    "formula": "=IF(1, \"a\", \"b\")",
    "expected": { "text": "a" }
  },
  {
    "id": "fn.if-zero",
    "description": "IF treats 0 as FALSE",
    "tags": ["functions", "if"],
    "formula": "=IF(0, \"a\", \"b\")",
    "expected": { "text": "b" }
  },
  {
    "id": "fn.if-text",
    "description": "IF of a non-numeric string is #VALUE!",
    "tags": ["functions", "if"],
    "formula": "=IF(\"x\", 1, 2)",
    "expected": { "error": "#VALUE!" }
  },
  {
    "id": "fn.if-short-circuit",
    "description": "IF does not evaluate the unused branch",
    "tags": ["functions", "if", "errors"],
    "quirks": ["if-short-circuit"],
    "formula": "=IF(TRUE, 1, 1/0)",
    "expected": { "number": 1 }
  },
  {
