[
  {
    "id": "agg.sum-text-literal",
    "description": "SUM(\"2\") coerces a scalar numeric string",
    "tags": ["sum", "functions"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUM(\"2\")",
    "expected": { "number": 2 }
  },
  {
    "id": "agg.sum-false-literal",
    "description": "SUM(FALSE) as a literal is 0",
    "tags": ["sum", "functions"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUM(FALSE)",
    "expected": { "number": 0 }
  },
  {
    "id": "agg.sum-mixed-scalars",
    "description": "SUM(1, TRUE, \"2\") = 4",
    "tags": ["sum", "functions"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUM(1, TRUE, \"2\")",
    "expected": { "number": 4 }
  },
  {
    "id": "agg.sum-range-bool-and-text",
    "description": "SUM skips both logicals and text in a range",
    "tags": ["sum", "functions"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUM(A1:A4)",
    "expected": { "number": 3 },
    "workbook": {
      "sheets": [{
        "name": "Sheet1",
        "cells": {
          "A1": { "number": 1 },
          "A2": { "bool": true },
          "A3": { "text": "2" },
          "A4": { "number": 2 }
        }
      }]
    }
  },
  {
    "id": "agg.sum-array-skips-logical",
