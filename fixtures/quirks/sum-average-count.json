    "tags": ["sum", "array"],
    "quirks": ["sum-arg-vs-range", "array-eval-mode"],
    "formula": "=SUM({1, TRUE, 2})",
    "expected": { "number": 3 }
  },
  {
    "id": "agg.sum-array-true-only",
    "description": "SUM({TRUE}) is 0",
    "tags": ["sum", "array"],
    "quirks": ["sum-arg-vs-range"],
    "formula": "=SUM({TRUE})",
    "expected": { "number": 0 }
  },
  {
