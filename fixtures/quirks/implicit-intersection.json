  {
    "id": "ii.dynamic-array-keeps-range",
    "description": "array_mode=dynamic-array returns the full column instead of intersecting",
    "tags": ["intersection", "array"],
    "quirks": ["implicit-intersection", "array-eval-mode"],
    "formula": "=A1:A3",
    "at": "Sheet1!B2",
    "expected": {
      "array": [[{ "number": 10 }], [{ "number": 20 }], [{ "number": 30 }]]
